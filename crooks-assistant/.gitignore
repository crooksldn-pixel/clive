# Secrets — never commit
credentials.json
token.json
.env
*.pem

# Benchmark audio: real recordings of a real office
bench/audio/*
!bench/audio/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Runtime state
.state/
logs/
.cache/
kb/.catalogue-cache.txt

# Test sessions: what the owner said and what was answered, on this Mac only
logs/test-sessions/
reports/*
!reports/.gitkeep

# Experience run artefacts. The reports are a record of a run on one machine, not source.
reports/experience/
node_modules/
package-lock.json
# Scratch probes. Review agents sometimes write these into tests/; they are not tests.
# Scratch probes a review agent writes into tests/ while hunting. They are not the
# suite and must never be committed with it: a run that counts them reports a test
# total nobody can reproduce. Both spellings, because both have happened.
tests/test_zz*.py
tests/test_probe*.py

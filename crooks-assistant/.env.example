# Non-secret configuration only. Secrets live in the macOS Keychain — see scripts/set_secrets.py
CROOKS_SHOPIFY_SHOP_DOMAIN=5wn03t-nm.myshopify.com
CROOKS_SHOPIFY_API_VERSION=2025-07
CROOKS_SHOPIFY_AUTH_MODE=client_credentials
# Speech: ElevenLabs Scribe first, local whisper.cpp as the automatic fallback.
# Set CROOKS_STT_PRIMARY=whisper to run entirely on this Mac.
CROOKS_STT_PRIMARY=scribe
CROOKS_SCRIBE_MODEL=scribe_v2
CROOKS_SCRIBE_LANGUAGE=eng
CROOKS_SCRIBE_TIMEOUT_S=20
# The assistant's voice. False falls the tablet back to its own Android voice.
CROOKS_TTS_ENABLED=true
# Derek. A .env line wins over the code's default: an older id left here keeps an older voice,
# and the health page names whatever ElevenLabs says the id really is.
CROOKS_TTS_VOICE_ID=Q0Et7LOU7VpeoeCRQAVS
CROOKS_TTS_VOICE_NAME=Derek
CROOKS_TTS_MODEL=eleven_flash_v2_5
CROOKS_TTS_OUTPUT_FORMAT=mp3_44100_128
CROOKS_TTS_TIMEOUT_S=10
# Start synthesising the moment the answer is known (false: only when the tablet asks).
CROOKS_TTS_PREFETCH=true
CROOKS_WHISPER_URL=http://127.0.0.1:8910
CROOKS_WHISPER_MODEL=small.en
CROOKS_CLAUDE_MODEL=sonnet
CROOKS_HOST=127.0.0.1
# Who may ask, as Tailscale logins, comma-separated. Empty: anyone on your tailnet.
# Open /whoami on the tablet to see the exact login to put here.
CROOKS_ALLOWED_LOGINS=
# Changes to the store and the inbox. Off (the default): the assistant is read-only. On: the
# assistant can PROPOSE a change (a note, tags, a cancellation, a refund, an address, a
# fulfilment, an email); nothing executes until the gesture on the card on the tablet, and
# only a login named above may make it. Every commit is checked against all three, plus the
# scope the change needs (Shopify per change, see SHOPIFY_SCOPES.md; Gmail from the token).
CROOKS_WRITES_ENABLED=false
# Let a request made on the Mac itself (no Tailscale login) apply a change. Off by default.
CROOKS_WRITES_LOCAL_OWNER=false
# What a change does beyond the change: policy, printed on the card, never a model argument.
CROOKS_CANCEL_REFUND=true
CROOKS_CANCEL_RESTOCK=true
CROOKS_CANCEL_NOTIFY=true
CROOKS_REFUND_NOTIFY=true
# The carrier as Shopify spells it (so the tracking number becomes a link), and whether a
# fulfilment sends the shipping email (off: Click & Drop or Admin may already send one).
CROOKS_CARRIER=Royal Mail
CROOKS_FULFIL_NOTIFY=false
# Email the assistant prepares. What it may do comes from the Gmail credential itself
# (modify: read and label; compose: draft and send) and shows per change on /health.
CROOKS_GMAIL_FROM_NAME=CROOKS
CROOKS_GMAIL_SIGNATURE=CROOKS
CROOKS_GMAIL_LINK_HOSTS=crooksldn.com,royalmail.com,parcelforce.com,evri.com,dpd.co.uk,yodel.co.uk
CROOKS_PORT=8000
CROOKS_TOOL_TIMEOUT_S=8
CROOKS_SESSION_IDLE_TIMEOUT_S=1800
CROOKS_LOG_DIR=logs

# Keep the tablet's recordings under bench/audio/ (off: an office is not recorded by default).
CROOKS_SAVE_CAPTURES=false

# The production experience recorder: an hour of real use, written down and minimised
# (logs/experience-recordings/). Off, and normal production is normal production — this is
# observability, not fixture mode, and it can never authorise a change. `make record-start`
# refuses while it is off rather than collecting nothing.
CROOKS_RECORD_EXPERIENCE=false
# The second opt-in. Off, a recording holds the SHAPE of what was said and the normalised
# intent; on, the sentence too, scrubbed of addresses, postcodes, phone numbers and long digit
# runs. For an afternoon spent diagnosing a mis-hearing, deliberately.
CROOKS_RECORD_TRANSCRIPTS=false

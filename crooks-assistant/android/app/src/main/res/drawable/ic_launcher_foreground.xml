<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher mark: a bare C on the CROOKS ground, drawn as a path so that it is one small
     file at every density instead of five PNGs. Deliberately not a logotype — on the Samsung's
     launcher the icon is 48dp and a wordmark at 48dp is a smudge. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M54,28 A26,26 0 1,0 54,80 A26,26 0 0,0 74,70"
        android:strokeColor="#EBE8E0"
        android:strokeWidth="9"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
</vector>

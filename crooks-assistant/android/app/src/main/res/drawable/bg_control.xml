<?xml version="1.0" encoding="utf-8"?>
<!-- A control, at rest. The same glass idea as the glass-control token in web/style.css — a
     barely-lit fill and a one-pixel edge — flattened into a solid, because a 2019 Mali-G71
     does not need to be asked to blur anything for a button that is on screen while nothing
     else is happening. Radius 14dp matches the radius-control token, so a native button and a
     web chip a second apart in the same session look like the same product. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#29FFFFFF" />
            <stroke android:width="1dp" android:color="#57FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#14FFFFFF" />
            <stroke android:width="1dp" android:color="#2EFFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>

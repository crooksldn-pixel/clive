<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template. `make install` (scripts/install_launchd.py) fills the placeholders from the
  current checkout and loads the result into your login session; do not copy this by hand.

  A restart loop here is almost always a wrong WorkingDirectory or a PATH without the `claude`
  binary — launchd does not read your shell profile, which is why PATH is spelled out and the
  CLI's absolute path is passed as CROOKS_CLAUDE_CLI_PATH.

  This is a LaunchAgent: it runs inside your login session, so the claude CLI's own login
  (auth=cli) and the Keychain work exactly as they do in a Terminal.
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.crooks.assistant</string>

  <key>ProgramArguments</key>
  <array>
    <string>{{PYTHON}}</string>
    <string>-m</string><string>uvicorn</string>
    <string>app.main:app</string>
    <string>--host</string><string>127.0.0.1</string>
    <string>--port</string><string>8000</string>
    <string>--no-proxy-headers</string>
  </array>

  <key>WorkingDirectory</key><string>{{ROOT}}</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>{{PATH}}</string>
    <key>HOME</key><string>{{HOME}}</string>
    <key>CROOKS_CLAUDE_CLI_PATH</key><string>{{CLAUDE}}</string>
    <key>PYTHONUNBUFFERED</key><string>1</string>
  </dict>

  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key><false/>
    <key>Crashed</key><true/>
  </dict>
  <!-- Without this, a crash loop restarts as fast as the CPU allows. -->
  <key>ThrottleInterval</key><integer>10</integer>

  <key>StandardOutPath</key><string>{{LOGS}}/assistant.out.log</string>
  <key>StandardErrorPath</key><string>{{LOGS}}/assistant.err.log</string>
  <key>ProcessType</key><string>Interactive</string>
</dict>
</plist>

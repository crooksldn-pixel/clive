# CROOKS OS — the production server's .env  (copy to the repository root as `.env`)
#
# Non-secret configuration only. Secrets are NOT here and never will be: on this host they
# are systemd encrypted credentials and a root-only 0600 directory. See
# docs/DEPLOY_LINUX.md and scripts/provision_secrets.py.
#
# This differs from .env.example (the Mac's) in exactly three places, each marked LINUX.

CROOKS_SHOPIFY_SHOP_DOMAIN=5wn03t-nm.myshopify.com
CROOKS_SHOPIFY_API_VERSION=2025-07
CROOKS_SHOPIFY_AUTH_MODE=client_credentials

# --- speech ---------------------------------------------------------------------------
# LINUX. whisper.cpp is not deployed here: no Core ML, no model, no build toolchain. This
# says so, rather than leaving a check permanently red for a thing that was never installed.
# /health then reports local speech as DISABLED instead of FAILED, does not call the host
# degraded for its absence, and skips the Core ML probe — but still reports speech as
# UNHEALTHY if Scribe goes down, because here there is nothing behind it.
CROOKS_WHISPER_ENABLED=false
CROOKS_STT_PRIMARY=scribe
CROOKS_SCRIBE_MODEL=scribe_v2
CROOKS_SCRIBE_LANGUAGE=eng
CROOKS_SCRIBE_TIMEOUT_S=20

# --- the voice ------------------------------------------------------------------------
CROOKS_TTS_ENABLED=true
CROOKS_TTS_VOICE_ID=Q0Et7LOU7VpeoeCRQAVS
CROOKS_TTS_VOICE_NAME=Derek
CROOKS_TTS_MODEL=eleven_flash_v2_5
CROOKS_TTS_OUTPUT_FORMAT=mp3_44100_128
CROOKS_TTS_TIMEOUT_S=10
CROOKS_TTS_PREFETCH=true
# The live words on the phone while the owner holds (a second speech-to-text use per question).
CROOKS_LIVE_TRANSCRIPT=true

CROOKS_CLAUDE_MODEL=sonnet

# --- transport ------------------------------------------------------------------------
# Loopback, always. `tailscale serve` supplies the trusted HTTPS origin that getUserMedia
# and speechSynthesis both require; binding 0.0.0.0 looks like it works and then fails on
# the browser API that actually matters. The service is never exposed publicly.
CROOKS_HOST=127.0.0.1
CROOKS_PORT=8000
# Who may ask, as Tailscale logins, comma-separated. Empty: nobody — every route but the public
# ones (liveness, /whoami, the page shells) is refused, and so is every change.
# Open /whoami on the tablet or the phone to see the exact login to put here.
CROOKS_ALLOWED_LOGINS=
# Every proxied request is checked with Tailscale itself: the connection must come from the
# root-owned /usr/sbin/tailscaled, and `tailscale whois` must name an allowed login. Leave it
# unset (the default is true). False skips that check, which is only for a machine without the
# tailscale CLI, knowingly, and never for this server.
# CROOKS_TAILSCALE_VERIFY=true
# Whether a request made on this server itself (curl on the host) may ask CLIVE and read the
# owner's records. It never lets the server apply a change. Leave it unset in production: other
# processes run here, and the host is not the owner. The server's own test-session commands work
# without it, through their own key (app/local_cli.py), and that key opens nothing else.
# CROOKS_LOCAL_OWNER=

# --- writes ---------------------------------------------------------------------------
# Shipped off. Off, CLIVE is read-only: every write tool is hidden from Claude and every commit
# is refused. Production runs with it on because the owner sets it to true in this server's .env;
# that is his decision, never the installer's or a deploy's (docs/DEPLOY_LINUX.md, "Running as
# root"). On, CLIVE still only prepares a change: nothing executes until it is confirmed on its
# card — by a login on CROOKS_ALLOWED_LOGINS, or by a member of the team he let in, for only the
# five changes he allowed the team (app/people/staff.py) — and the store must have granted the
# scope. Do not turn it on to "see if it works".
CROOKS_WRITES_ENABLED=false
# Whether a request made on this server itself may apply a business write. Keep it false: with it
# on, any process on the host could commit a change.
CROOKS_WRITES_LOCAL_OWNER=false

# --- test mode ---------------------------------------------------------------------------
# Always on: each day is one test session the backend starts itself, so everything the owner
# does is written down (logs/test-sessions/, redacted, 0600) without starting anything. Screen
# snapshots add a copy of what the page showed at each answer and failure, drawn afterwards by
# `make test-session-screens`; those carry what the screen showed, customer names included.
CROOKS_TEST_SESSION_ALWAYS=false
CROOKS_TEST_SESSION_KEEP_DAYS=14
CROOKS_TEST_SESSION_KEEP_NAMED_DAYS=90
# Keep false in production: a snapshot is a copy of what the screen showed, customer names included.
CROOKS_SCREEN_SNAPSHOTS=false

# --- the interaction record ----------------------------------------------------------------
# Always recording (app/observability/interactions.py, docs/RECORDING.md): every turn and gesture
# of normal use, so CLIVE can answer "what's on my screen?", "why aren't you showing me X?" and
# "look at our interaction" from what it drew and did, not from memory. logs/interactions/, one
# file a day, 0600 in a 0700 folder, on this server only; redacted as a test session is, with the
# owner's words and the cards' titles written by their shape. It is not a test session and is
# never reported as one. On unless set false here.
CROOKS_INTERACTION_RECORD=true
CROOKS_INTERACTION_RECORD_KEEP_DAYS=7
CROOKS_INTERACTION_RECORD_DAY_MB=16
# His words and the cards' titles kept as said, still scrubbed of contact details and of the names
# reads returned. His decision, never a default: a customer's name he says that no read returned
# cannot be found and taken out.
CROOKS_INTERACTION_RECORD_WORDS=false

# --- build objectives --------------------------------------------------------------------
# Which engineering loop builds what CLIVE files (on the owner's tap): worker-01 reads
# clive/control/worker-01-inbox. The checks CLIVE fills in run on that host with its own
# interpreter. Filing also needs the github_engineering_inbox_token secret and writes on.
# Left unset in production for now: filing from CLIVE (F-ENG) is deferred and its credential is
# parked in /etc/crooks-os/credentials-parked/. Unset means off: every engineering tool says filing
# is switched off and nothing reaches GitHub, whatever token the host holds
# (app/engineering_switch.py). Set it only when the owner un-parks it, after its own review.
# CROOKS_ENGINEERING_HOST=worker-01
# CROOKS_ENGINEERING_CHECK_PYTHON=/home/user/clive/crooks-assistant/.venv/bin/python

CROOKS_CANCEL_REFUND=true
CROOKS_CANCEL_RESTOCK=true
CROOKS_CANCEL_NOTIFY=true
CROOKS_REFUND_NOTIFY=true
CROOKS_CARRIER=Royal Mail
CROOKS_FULFIL_NOTIFY=false

CROOKS_GMAIL_FROM_NAME=CROOKS
CROOKS_GMAIL_SIGNATURE=CROOKS
CROOKS_GMAIL_LINK_HOSTS=crooksldn.com,royalmail.com,parcelforce.com,evri.com,dpd.co.uk,yodel.co.uk

CROOKS_TOOL_TIMEOUT_S=8
CROOKS_SESSION_IDLE_TIMEOUT_S=1800

# LINUX. Logs go to the journal as well (journalctl -u crooks-assistant); this is the
# rotating file the existing logs mechanism writes, with the same redaction filter.
CROOKS_LOG_DIR=logs

# An office is not recorded by default.
CROOKS_SAVE_CAPTURES=false
CROOKS_RECORD_EXPERIENCE=false
CROOKS_RECORD_TRANSCRIPTS=false

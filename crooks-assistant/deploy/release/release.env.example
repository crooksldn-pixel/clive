# /etc/crooks-os/release.env: the release service's switches. George's to set; no program writes them.
# Copied here once, at installation, exactly as below (switched off, no rule), then set as he ruled on
# 8 Oct by the install steps in docs/RELEASE_SERVICE.md, done by hand.

# Off: the service does nothing at all. On: it deploys clive/trunk's head when every condition holds.
CLIVE_RELEASE_ENABLED=false

# Who holds deploy authority. Until it is named here, nothing is ever deployed.
#   exact_sha_review   a reviewer's SHIP record for exactly the SHA (branch claude/review-<sha8>-record)
#   owner_waiver       George's own waiver for exactly the SHA (given on the server, or with his passkey)
# George named owner_waiver on 8 Oct 2026 (DEC-071, ruling 7; DEC-072): the install steps in
# docs/RELEASE_SERVICE.md write it in, with CLIVE_RELEASE_ENABLED=true, keeping dry run on (ruling 8).
CLIVE_RELEASE_RULE=off

# On (and on when this line is missing): every tick works out what it would do, says so on CLIVE's
# Builds screen, and changes nothing. Only CLIVE_RELEASE_DRY_RUN=false lets it deploy. Keep it on for
# the first days after switching on, so its plan can be compared with a hand deploy.
CLIVE_RELEASE_DRY_RUN=true

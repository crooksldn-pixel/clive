# CLIVE Preorders service. Copy to .env beside this file, on the server only; every value is
# read as PREORDERS_<NAME>. Live secrets never go in the repo or in chat.

# --- Shopify: the CROOKS Operations app (the same client id and secret as Returns/Shipping) ---
PREORDERS_SHOP_DOMAIN=5wn03t-nm.myshopify.com
PREORDERS_SHOPIFY_CLIENT_ID=
PREORDERS_SHOPIFY_CLIENT_SECRET=
# "off" until Shopify has granted the purchase-option scopes and one test preorder works;
# then "shopify". Off: nothing is sold as a preorder (no imitation); the rest works.
PREORDERS_SELLING_PLANS=off
# The location received stock is added to. Empty: the first active location that fulfils online
# orders.
PREORDERS_LOCATION_ID=

# --- Customer email (transactional only) ---
# "off": nothing can be sent, and the screens say so. "resend": Resend's API with this key.
PREORDERS_EMAIL_PROVIDER=off
PREORDERS_RESEND_API_KEY=
PREORDERS_EMAIL_FROM=CROOKS <orders@crooksldn.com>
PREORDERS_EMAIL_REPLY_TO=
PREORDERS_STORE_URL=https://crooksldn.com

# --- CLIVE (/preorders/api/v1): comma-separated bearer keys, generated on the server ---
PREORDERS_CLIVE_READ_KEYS=
PREORDERS_CLIVE_WRITE_KEYS=

# --- Timers ---
PREORDERS_TICK_INTERVAL_S=30
PREORDERS_RECONCILE_EVERY_MIN=60

# CROOKS Operations on one address over HTTPS (certificate from Let's Encrypt). One embedded
# Shopify app; each section is its own service with its own data:
#   /shipping/*  -> clive-shipping (prefix removed: the service sees /admin, /health ...)
#   /preorders/* -> clive-preorders (prefix removed), and /proxy/preorders/* (kept) for the
#                   storefront through the app proxy
#   /settings    -> a static page linking to each service's own settings (ops-shell/)
#   everything else -> crooks-returns (its admin, the customer portal proxy, webhooks)
{$RETURNS_DOMAIN} {
	encode gzip

	handle_path /shipping/* {
		reverse_proxy shipping:8120
	}

	handle_path /preorders/* {
		reverse_proxy preorders:8130
	}

	# The storefront's Notify me signups come through the shared app proxy
	# (crooksldn.com/apps/returns/preorders/* -> /proxy/preorders/*), signed by Shopify.
	handle /proxy/preorders/* {
		reverse_proxy preorders:8130
	}

	handle /settings {
		root * /srv/ops
		rewrite * /settings.html
		templates
		header Content-Security-Policy "frame-ancestors https://{$SHOPIFY_SHOP_DOMAIN} https://admin.shopify.com;"
		header Cache-Control "no-store"
		file_server
	}

	handle {
		reverse_proxy returns:8100
	}
}

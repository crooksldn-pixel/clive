# CROOKS Returns service. Copy to .env beside this file; every value is RETURNS_<NAME>.

# --- Shopify (a Dev Dashboard app with an app proxy; see README) ---
RETURNS_SHOP_DOMAIN=5wn03t-nm.myshopify.com
RETURNS_API_VERSION=2026-10
RETURNS_SHOPIFY_AUTH_MODE=client_credentials
RETURNS_SHOPIFY_CLIENT_ID=
# Also signs the app proxy requests and the webhooks.
RETURNS_SHOPIFY_CLIENT_SECRET=
# Where restocked returns go back on the shelf (gid://shopify/Location/...). Empty: no auto restock.
RETURNS_RESTOCK_LOCATION_ID=

# --- the service ---
RETURNS_PUBLIC_BASE_URL=https://returns.crooksldn.com
RETURNS_DB_PATH=/var/lib/crooks-returns/returns.sqlite3
# Long and random: `python3 -c "import secrets; print(secrets.token_urlsafe(48))"`
RETURNS_SESSION_SECRET=

# --- policy (owner decisions, 2026-10-03) ---
RETURNS_WINDOW_DAYS=14
RETURNS_FAULT_WINDOW_DAYS=30
# from_pence:bonus_pence. £25 tee -> £30 credit; £60 item -> £70 credit. Boundary at £40: confirm.
RETURNS_CREDIT_BONUS_BANDS=0:500,4000:1000
# What Click & Drop charges CROOKS for a Tracked Returns label, in pence. Empty: change-of-mind
# refunds are self-ship only.
RETURNS_RETURN_LABEL_COST_PENCE=
RETURNS_REFUND_OUTBOUND_SHIPPING_ON_FULL_RETURN=true
RETURNS_LABEL_DUE_HOURS=24
RETURNS_NON_RETURNABLE_TAGS=non-returnable

# --- Royal Mail Click & Drop (Online Business Account) ---
RETURNS_CLICKDROP_API_KEY=
RETURNS_CLICKDROP_SERVICE_CODE=
RETURNS_CLICKDROP_PACKAGE_FORMAT=parcel
RETURNS_CLICKDROP_WEIGHT_GRAMS=600
# Shown to customers who send it back themselves.
RETURNS_RETURNS_ADDRESS_NAME=CROOKS LDN Returns
RETURNS_RETURNS_ADDRESS_LINE1=
RETURNS_RETURNS_ADDRESS_LINE2=
RETURNS_RETURNS_ADDRESS_CITY=
RETURNS_RETURNS_ADDRESS_POSTCODE=

# --- CLIVE ---
RETURNS_CLIVE_READ_KEYS=
RETURNS_CLIVE_WRITE_KEYS=
RETURNS_CLIVE_WEBHOOK_URL=
RETURNS_CLIVE_WEBHOOK_SECRET=

# CROOKS Returns service. Copy to .env beside this file; every value is RETURNS_<NAME>.

# --- Shopify (a Dev Dashboard app with an app proxy; see README) ---
RETURNS_SHOP_DOMAIN=5wn03t-nm.myshopify.com
RETURNS_API_VERSION=2026-10
RETURNS_SHOPIFY_AUTH_MODE=client_credentials
RETURNS_SHOPIFY_CLIENT_ID=
# Also signs the app proxy requests and the webhooks.
RETURNS_SHOPIFY_CLIENT_SECRET=
# Where restocked returns go back on the shelf (gid://shopify/Location/...). Empty: no auto restock.
RETURNS_RESTOCK_LOCATION_ID=

# --- the service ---
# Your own server only (docker-compose.yml): the address customers' requests arrive on.
RETURNS_DOMAIN=returns.crooksldn.com
# The server's public IPv4 address, so the site does not clash with Tailscale on port 443.
RETURNS_BIND_IP=2.28.233.59
RETURNS_PUBLIC_BASE_URL=https://returns.crooksldn.com
RETURNS_DB_PATH=/var/lib/crooks-returns/returns.sqlite3
# Long and random: `python3 -c "import secrets; print(secrets.token_urlsafe(48))"`
RETURNS_SESSION_SECRET=

# Pilot: only these order numbers may use the portal (testing on the real store). Empty: open.
RETURNS_PILOT_ORDER_NUMBERS=

# --- policy (owner decisions, 2026-10-03) ---
RETURNS_WINDOW_DAYS=14
RETURNS_FAULT_WINDOW_DAYS=30
# from_pence:bonus_pence. £25 tee -> £30 credit; £60 item -> £70 credit. Boundary at £40: confirm.
RETURNS_CREDIT_BONUS_BANDS=0:500,4000:1000
# What Click & Drop charges CROOKS for a Tracked Returns label, in pence. Empty: change-of-mind
# refunds are self-ship only.
RETURNS_RETURN_LABEL_COST_PENCE=
RETURNS_REFUND_OUTBOUND_SHIPPING_ON_FULL_RETURN=true
RETURNS_LABEL_DUE_HOURS=24
RETURNS_NON_RETURNABLE_TAGS=non-returnable

# --- return labels ---
# Who books return labels: parcel2go, clickdrop, or none (staff add tracking by hand).
RETURNS_LABEL_PROVIDER=parcel2go
RETURNS_PARCEL_WEIGHT_GRAMS=600
RETURNS_PARCEL_CM=35x25x8
# Couriers want a contact on our side, and a phone for the sender (ours if the customer has none).
RETURNS_RETURNS_CONTACT_EMAIL=team@crooksldn.com
RETURNS_RETURNS_CONTACT_PHONE=

# --- Parcel2Go (PrePay). Sandbox: https://sandbox.parcel2go.com with sandbox credentials ---
RETURNS_P2G_BASE_URL=https://www.parcel2go.com
# The client id includes the part after the colon, e.g. 0590...:CrooksReturns
RETURNS_P2G_CLIENT_ID=
RETURNS_P2G_CLIENT_SECRET=
# Offered to the customer, best first: evri, inpost, royal-mail, collectplus
RETURNS_P2G_COURIERS=evri,inpost,royal-mail
# Set the same secret on the API credential's Webhooks, URL https://returns.crooksldn.com/webhooks/parcel2go
RETURNS_P2G_WEBHOOK_SECRET=

# --- Royal Mail Click & Drop (Online Business Account), if RETURNS_LABEL_PROVIDER=clickdrop ---
RETURNS_CLICKDROP_API_KEY=
RETURNS_CLICKDROP_SERVICE_CODE=
RETURNS_CLICKDROP_PACKAGE_FORMAT=parcel
RETURNS_CLICKDROP_WEIGHT_GRAMS=600
# Where returns come back to: shown to customers who post it themselves, and the labels' address.
RETURNS_RETURNS_ADDRESS_NAME=CROOKS LDN Returns
RETURNS_RETURNS_ADDRESS_LINE1=
RETURNS_RETURNS_ADDRESS_LINE2=
RETURNS_RETURNS_ADDRESS_CITY=
RETURNS_RETURNS_ADDRESS_POSTCODE=

# --- CLIVE ---
RETURNS_CLIVE_READ_KEYS=
RETURNS_CLIVE_WRITE_KEYS=
# Each recorded event to CLIVE's door (id, type, return id, time; signed). Empty: off.
# RETURNS_CLIVE_WEBHOOK_URL=https://hooks.crooksldn.com/hooks/returns
RETURNS_CLIVE_WEBHOOK_URL=
# openssl rand -hex 32; the same value on CLIVE's Connections screen (CROOKS Returns, Events secret).
RETURNS_CLIVE_WEBHOOK_SECRET=

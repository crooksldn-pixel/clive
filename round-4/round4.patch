+def test_a_deeply_nested_inbox_record_is_refused_and_the_dispatcher_still_ticks(env, tmp_path):
+    assert len(DEEP) < inbox_module.MAX_RECORD_BYTES
+    _commit_raw(env.origin, {"requests/r-deep.json": DEEP})

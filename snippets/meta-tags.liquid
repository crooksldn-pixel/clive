{% doc %}
  Renders all meta tags for the page including Open Graph, Twitter Cards, and SEO tags.

  @param {object} [product] - The product object, available on product pages for price meta tags.
{% enddoc %}

<meta charset="utf-8">
<meta
  http-equiv="X-UA-Compatible"
  content="IE=edge"
>
<meta
  name="viewport"
  content="width=device-width,initial-scale=1"
>
<meta
  name="view-transition"
  content="same-origin"
>
<meta
  name="theme-color"
  content=""
>

{%- comment -%}
  Homepage fallback (SEO audit 2026-09-30): the homepage title in Online Store >
  Preferences was just the shop name and the meta description was blank, so
  search engines and AI tools got no description of the brand. These defaults
  apply ONLY while Preferences is left at the shop name / blank; anything set
  in admin still wins.

  Promptd SEO/GEO audit (2026-10), finding P1: the old default title ran to 58
  characters, past the ~561px a results page shows. It now uses the audit's own
  wording, and the description stays under 155 characters.
{%- endcomment -%}
{%- liquid
  comment
    Shopify hands page_title and page_description over already HTML-escaped.
    Trimming them turns them into plain strings, so they are decoded here once
    and escaped once on output; otherwise "&" would reach the page as "&amp;amp;".
    &amp; goes last so "&amp;lt;" decodes to the text "&lt;", not to "<".
  endcomment
  assign crk_page_title = page_title | strip_newlines | strip | replace: '&quot;', '"' | replace: '&#39;', "'" | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&amp;', '&'
  assign crk_page_description = page_description | strip_html | strip_newlines | strip | replace: '&nbsp;', ' ' | replace: '&quot;', '"' | replace: '&#39;', "'" | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&amp;', '&'
  if request.page_type == 'index'
    if crk_page_title == blank or crk_page_title == shop.name
      assign crk_page_title = 'Crooks London Streetwear | Fleece, Denim & Tees'
    endif
    if crk_page_description == blank
      assign crk_page_description = 'CROOKSLDN, the Crooks London streetwear label: 550gsm Convict fleece, 14oz Yard denim, graphic tees and MotionTec socks. Free UK shipping over £30.'
    endif
  endif

  comment
    Description fallbacks (audit M1: 7 missing, 5 over 155 characters). Only
    used when Shopify has nothing: a collection with no description lists what
    is actually in it, and a product with no description says what it is and
    what it costs. Nothing here is invented — every word comes from the
    store's own data.
  endcomment
  if crk_page_description == blank and request.page_type == 'collection' and collection
    assign crk_names = ''
    for p in collection.products limit: 3
      assign crk_names = crk_names | append: p.title
      if forloop.last == false
        assign crk_names = crk_names | append: ', '
      endif
    endfor
    if crk_names != blank
      assign crk_page_description = 'Shop ' | append: collection.title | append: ' from CROOKSLDN (Crooks London): ' | append: collection.products_count | append: ' pieces, including ' | append: crk_names | append: '.'
    endif
  endif
  if crk_page_description == blank and request.page_type == 'product' and product
    assign crk_price_text = product.price | money | strip_html
    assign crk_page_description = product.title | append: ' from CROOKSLDN (Crooks London), ' | append: crk_price_text
    if product.type != blank
      assign crk_page_description = crk_page_description | append: '. ' | append: product.type
    endif
    assign crk_page_description = crk_page_description | append: '.'
  endif

  comment
    Length guard: over 160 characters, cut back to the last whole word that
    fits 155 and close with an ellipsis, rather than leave a search engine to
    cut it mid-word.
  endcomment
  if crk_page_description.size > 160
    assign crk_words = crk_page_description | truncate: 156, '' | split: ' '
    assign crk_keep = crk_words.size | minus: 1
    assign crk_page_description = ''
    for w in crk_words limit: crk_keep
      assign crk_page_description = crk_page_description | append: w | append: ' '
    endfor
    assign crk_page_description = crk_page_description | strip | append: '…'
  endif

  comment
    Title (audit P1-P6): one brand suffix, one separator, and the brand only
    where it fits. A suffix already typed in admin (" | CROOKSLDN", " — CROOKSLDN"
    and the like) is taken off, then " | CROOKSLDN" is added back only if the
    whole title stays within 56 characters. The six titles the audit flagged
    were 57-58 characters with the brand; every title it passed was 56 or
    under. The brand is never lost: og:site_name and the WebSite structured
    data carry it on every page.
  endcomment
  assign crk_brand = shop.name
  assign crk_base = crk_page_title
  assign crk_seps = '|,–,—,-' | split: ','
  for crk_sep in crk_seps
    assign crk_tail = ' ' | append: crk_sep | append: ' ' | append: crk_brand
    if crk_base.size > crk_tail.size
      assign crk_cut = crk_base.size | minus: crk_tail.size
      assign crk_end = crk_base | slice: crk_cut, crk_tail.size
      if crk_end == crk_tail
        assign crk_base = crk_base | slice: 0, crk_cut | strip
      endif
    endif
  endfor
  assign crk_title = crk_base
  if current_tags
    assign crk_tag_list = current_tags | join: ', '
    assign crk_title = crk_title | append: ' – tagged "' | append: crk_tag_list | append: '"'
  endif
  if current_page != 1
    assign crk_title = crk_title | append: ' – Page ' | append: current_page
  endif
  if crk_title == blank
    assign crk_title = crk_brand
  else
    unless crk_base contains crk_brand
      assign crk_with_brand = crk_title | append: ' | ' | append: crk_brand
      if crk_with_brand.size <= 56
        assign crk_title = crk_with_brand
      endif
    endunless
  endif

  assign og_title = crk_page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = crk_page_description | default: shop.description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta
  property="og:site_name"
  content="{{ shop.name }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- if page_image -%}
  {%- comment -%}
    Share image at 1200px (Open Graph's recommended width) rather than the
    original upload, which on this store is a 1-2 MB PNG.
  {%- endcomment -%}
  {%- liquid
    assign crk_og_w = page_image.width | at_most: 1200
    assign crk_og_h = page_image.height | times: crk_og_w | divided_by: page_image.width
  -%}
  <meta
    property="og:image"
    content="http:{{ page_image | image_url: width: 1200 }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ page_image | image_url: width: 1200 }}"
  >
  <meta
    property="og:image:width"
    content="{{ crk_og_w }}"
  >
  <meta
    property="og:image:height"
    content="{{ crk_og_h }}"
  >
  <meta
    property="og:image:alt"
    content="{{ page_image.alt | default: og_title | escape }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta
    name="twitter:site"
    content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}"
  >
{%- endif -%}
<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

<title>{{ crk_title | escape }}</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

{% if crk_page_description != blank %}
  <meta
    name="description"
    content="{{ crk_page_description | escape }}"
  >
{% endif %}

{%- comment -%}
  Internal search results and the cart are utility pages: they change with
  every query and basket, so they are kept out of the index while their links
  are still followed. Product, collection and content pages are untouched
  (audit G1: public pages stay crawlable; G13: no filler on cart/search).
{%- endcomment -%}
{%- if request.page_type == 'search' or request.page_type == 'cart' -%}
  <meta
    name="robots"
    content="noindex, follow"
  >
{%- endif -%}

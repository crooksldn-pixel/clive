{{ 'crooks.css' | asset_url | stylesheet_tag }}
<script src="{{ 'crooks-record.js' | asset_url }}" defer></script>
<script src="{{ 'crooks-set.js' | asset_url }}" defer></script>

{%- liquid
  comment
    No size is chosen for the shopper. `selected_or_first_available_variant`
    picks the first in-stock variant on their behalf, and a size rendered as
    already-selected reads as a decision they made — so ADD TO BAG can post a
    size nobody chose. `selected_variant` is nil unless ?variant= is in the URL,
    which keeps shared links, the no-JS size links below and the browser Back
    button working while leaving a cold landing unselected.

    A product with exactly one variant is not a choice, so it stays selected.
  endcomment
  assign crk_var = product.selected_variant
  if product.variants.size == 1
    assign crk_var = product.variants.first
  endif

  comment
    Filter precedence: `money` is formatted into a variable first. Chaining it
    inside the output tag is the trap this codebase has hit four times.
  endcomment
  assign crk_price_display = product.price | money
  if crk_var
    assign crk_price_display = crk_var.price | money
  endif

  assign crk_col = collections[section.settings.collection]

  assign crk_index = 0
  assign crk_total = crk_col.products_count
  for p in crk_col.products
    if p.id == product.id
      assign crk_index = forloop.index
      break
    endif
  endfor

  comment
    Size option = the first option that is not Title.
  endcomment
  assign crk_size_opt = null
  for opt in product.options_with_values
    assign opt_down = opt.name | downcase
    if opt_down != 'title' and crk_size_opt == null
      assign crk_size_opt = opt
    endif
  endfor
  comment
    The pre-JS label has to name the real option too, or socks get a button
    reading "Select a size" on a product with no sizes. crooks-record.js does
    the same thing once it runs; this is what the server sends before it does.
    Formatted into a variable first — filter precedence.
  endcomment
  assign crk_single = false
  assign crk_has_options = true
  if product.variants.size == 1 and product.variants.first.title == 'Default Title'
    assign crk_single = true
    assign crk_has_options = false
    assign crk_size_opt = null
  endif

  assign crk_select_label = section.settings.label_select
  if crk_size_opt and section.settings.label_select_option != blank
    assign crk_select_label = section.settings.label_select_option | replace: '[option]', crk_size_opt.name
  endif

  assign mf = product.metafields.crooks
  assign rows = mf.measurements.value
  assign has_measurements = false
  if rows and rows.size > 0
    assign has_measurements = true
  endif

  # A set has no measurements of its own because it is not one garment. Left
  # alone it showed no size guide at all — on the page where a shopper is
  # picking two sizes at once, which is exactly where sizing matters most.
  # crooks.set_components names the pieces, and each of those is measured.
  assign crk_parts = mf.set_components.value
  assign crk_parts_measured = 0
  if has_measurements == false and crk_parts
    for crk_part in crk_parts
      assign crk_prows = crk_part.metafields.crooks.measurements.value
      if crk_prows and crk_prows.size > 0
        assign crk_parts_measured = crk_parts_measured | plus: 1
      endif
    endfor
  endif
  assign crk_show_measure = false
  if has_measurements or crk_parts_measured > 0
    assign crk_show_measure = true
  endif
-%}

{%- render 'crooks-schema-product', product: product -%}

<div
  class="crk-root crk-record"
  data-crk-section="exhibit-record"
  data-crk-label-add="{{ section.settings.label_add | escape }}"
  data-crk-label-select="{{ section.settings.label_select | escape }}"
  data-crk-label-sold="{{ section.settings.label_sold | escape }}"
  data-crk-label-instock="{{ section.settings.label_in_stock | escape }}"
  data-crk-label-low="{{ section.settings.label_low | escape }}"
  data-crk-label-soldsize="{{ section.settings.label_sold_size | escape }}"
  data-crk-photo-label="{{ section.settings.photo_label | escape }}"
  data-crk-low-threshold="{{ section.settings.low_stock_threshold }}"
  data-crk-label-select-option="{{ section.settings.label_select_option | escape }}"
  data-crk-label-added="{{ section.settings.label_added | escape }}"
  data-crk-label-added-plain="{{ section.settings.label_added_plain | escape }}"
  data-crk-label-adderror="{{ section.settings.label_add_error | escape }}"
  data-crk-label-viewbag="{{ section.settings.label_view_bag | escape }}"
  data-crk-label-adding="{{ section.settings.label_adding | escape }}"
  data-crk-cart-url="{{ routes.cart_url }}"
  {%- unless section.settings.show_texture %} data-crk-texture="off"{% endunless %}
>

  <div class="crk-wrap">
    {%- comment -%} ---------- meta strip ---------- {%- endcomment -%}
    <header class="crk-meta">
      <a href="{{ crk_col.url | default: routes.root_url }}" class="crk-label">{{ section.settings.back_label }}</a>
      {%- if crk_index > 0 -%}
        <span class="crk-display crk-meta-exh">
          {{ section.settings.exhibit_word }} {% if crk_index < 10 %}0{% endif %}{{ crk_index }} / {{ crk_total }}
        </span>
      {%- endif -%}
      {%- if product.type != blank -%}
        <span class="crk-data crk-dim">{{ product.type | upcase }}</span>
      {%- endif -%}
      {%- if mf.case_ref.value != blank -%}
        <span class="crk-data crk-dim">{{ section.settings.case_word }} {{ mf.case_ref.value }}</span>
      {%- endif -%}
    </header>

    <div class="crk-grid">
      {%- comment -%}
        ---------- product header ----------
        Above the gallery in source order, which is the mobile order: a shopper
        should know what this is and what it costs before scrolling a picture.
        On desktop it moves into the right column above the buy panel via grid
        placement, so the two-column layout is unchanged.

        Every row here is gated on real data. The rating renders only when
        Shopify's own reviews.rating and reviews.rating_count metafields carry
        values — the ones a review app writes. No app, no reviews, no row.
        Stars are never drawn from nothing.
      {%- endcomment -%}
      <header class="crk-record__head">
        <h1 class="crk-display crk-title">{% render 'crooks-title', product: product %}</h1>
        <div class="crk-display crk-price crk-record__price" data-crk-price>{{ crk_price_display }}</div>

        {%- liquid
          assign crk_rating = product.metafields.reviews.rating.value
          assign crk_rating_n = product.metafields.reviews.rating_count
          assign crk_has_rating = false
          if crk_rating and crk_rating.rating and crk_rating_n and crk_rating_n > 0
            assign crk_has_rating = true
          endif
        -%}
        {%- if crk_has_rating -%}
          {%- liquid
            comment
              Rounded to whole stars for the glyph row; the exact figure is in
              the accessible text beside it, so nothing is overstated visually
              without the real number being available.
            endcomment
            assign crk_stars = crk_rating.rating | round
            assign crk_scale = crk_rating.scale_max | plus: 0
          -%}
          <p class="crk-record__rating">
            <span class="crk-record__stars" aria-hidden="true">
              {%- for i in (1..crk_scale) -%}
                <span{% if i > crk_stars %} data-crk-star-off="true"{% endif %}>&#9733;</span>
              {%- endfor -%}
            </span>
            <span class="crk-record__reviews">({{ crk_rating_n }} {{ section.settings.reviews_label }})</span>
            <span class="crk-sr">{{ crk_rating.rating }} {{ section.settings.rating_sr }} {{ crk_rating.scale_max }}</span>
          </p>
        {%- endif -%}

        {%- if product.metafields.crooks.subtitle != blank -%}
          <p class="crk-record__sub">{{ product.metafields.crooks.subtitle }}</p>
        {%- endif -%}
      </header>

      {%- comment -%} ---------- gallery ---------- {%- endcomment -%}
      <div class="crk-record__gallery">
        <div
          class="crk-tray crk-tray-main"
          role="group"
          aria-label="{{ section.settings.gallery_label | escape }}"
          tabindex="0"
          data-crk-gallery
        >
          {%- for image in product.images -%}
            {%- liquid
              comment
                The first photo is the page's largest paint (measured on the
                Yard Jeans page): it was already eager, it now also asks for
                high fetch priority so it is not queued behind scripts
                (Promptd audit 2026-10, finding I4).
              endcomment
              if forloop.first
                assign img_loading = 'eager'
                assign img_prio = 'high'
              else
                assign img_loading = 'lazy'
                assign img_prio = 'auto'
              endif
              assign img_alt = image.alt | default: product.title
              assign gal_src = image.src | downcase
              assign main_img_cls = 'crk-main-img'
              unless gal_src contains '.jpg' or gal_src contains '.jpeg'
                assign main_img_cls = main_img_cls | append: ' crk-product-image'
              endunless
            -%}
            <div data-crk-slide {% unless forloop.first %}hidden{% endunless %}>
              {{
                image
                | image_url: width: 1400
                | image_tag:
                  widths: '400, 600, 800, 1000, 1400',
                  sizes: '(min-width: 960px) 55vw, 100vw',
                  loading: img_loading,
                  fetchpriority: img_prio,
                  class: main_img_cls,
                  alt: img_alt
              }}
            </div>
          {%- endfor -%}
        </div>

        {%- comment -%}
          Counter and dots sit over the foot of the image rather than under it,
          so the gallery reads as one object and the fit strip below it is not
          pushed down the screen. Both are decoration: the slides themselves
          carry the alt text and the thumb buttons carry the accessible names.
        {%- endcomment -%}
        <div class="crk-gallery-chrome">
          <span class="crk-counter" data-crk-photo-counter aria-hidden="true">
            {{ section.settings.photo_label | replace: '[i]', 1 | replace: '[n]', product.images.size }}
          </span>
        </div>

        {%- if product.images.size > 1 -%}
          <div class="crk-dots" aria-hidden="true">
            {%- for image in product.images -%}
              <span class="crk-dot" data-crk-dot data-active="{% if forloop.first %}true{% else %}false{% endif %}"></span>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if product.images.size > 1 -%}
          <div class="crk-thumbs">
            {%- for image in product.images -%}
              <button
                type="button"
                class="crk-thumb"
                data-crk-thumb
                data-active="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-label="{{ section.settings.photo_label | replace: '[i]', forloop.index | replace: '[n]', product.images.size | escape }}"
              >
                {{ image | image_url: width: 128 | image_tag: loading: 'lazy', alt: '' }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- comment -%}
          Fit summary. Assembled from whichever of the three metafields are
          filled in, so a product with only a fit reads "OVERSIZED FIT" and one
          with none renders nothing at all rather than a strip of separators.
        {%- endcomment -%}
        {%- liquid
          assign crk_fit = product.metafields.crooks.fit
          assign crk_mh = product.metafields.crooks.model_height
          assign crk_ms = product.metafields.crooks.model_size
          assign crk_fit_parts = ''
          if crk_fit != blank
            assign crk_fit_parts = crk_fit
          endif
          assign crk_model_line = ''
          if crk_mh != blank and crk_ms != blank
            assign crk_model_line = section.settings.fit_model_template | replace: '[height]', crk_mh
            assign crk_model_line = crk_model_line | replace: '[size]', crk_ms
          endif
          if crk_model_line != blank
            if crk_fit_parts != blank
              assign crk_fit_parts = crk_fit_parts | append: '  //  ' | append: crk_model_line
            else
              assign crk_fit_parts = crk_model_line
            endif
          endif
        -%}
        {%- if crk_fit_parts != blank -%}
          <p class="crk-record__fit">{{ crk_fit_parts }}</p>
        {%- endif -%}
      </div>

      {%- comment -%} ---------- record panel ---------- {%- endcomment -%}
      <div class="crk-panel crk-panel-record crk-panel-sticky">
        {%- comment -%}
          The title and price now live in crk-record__head above the gallery.
          data-crk-price moved with them; crooks-record.js repaints by attribute,
          not by position, so variant changes still rewrite the right element.
        {%- endcomment -%}

        {%- if product.available -%}
          {%- form 'product', product, id: 'crk-product-form' -%}
            <input type="hidden" name="id" value="{{ crk_var.id }}" data-crk-variant-id>

            {%- if crk_has_options -%}
              {%- comment -%}
                Variant matrix as DOM data, not a JSON blob in a <script> — the
                house rule forbids Liquid inside script tags. One <span> per
                variant carrying its option values and buy state.
              {%- endcomment -%}
              <div data-crk-variants hidden>
                {%- for v in product.variants -%}
                  {%- liquid
                    assign vq = 0
                    if v.inventory_quantity > 0
                      assign vq = v.inventory_quantity
                    endif
                  -%}
                  <span
                    data-id="{{ v.id }}"
                    data-o1="{{ v.option1 | escape }}"
                    data-o2="{{ v.option2 | escape }}"
                    data-o3="{{ v.option3 | escape }}"
                    data-available="{{ v.available }}"
                    data-qty="{{ vq }}"
                    data-price="{{ v.price | money }}"
                  ></span>
                {%- endfor -%}
              </div>

              {%- comment -%}
                Every option renders, whatever it is called and whatever order it
                comes in. Nothing here assumes "Size" or a single option.
              {%- endcomment -%}
              {%- comment -%}
                Label left, size guide right, on one row above the buttons. The
                guide used to sit under the row as a third stacked control,
                which pushed the dispatch line and the button further down the
                one screen that has to sell the garment.
              {%- endcomment -%}
              {%- for option in product.options_with_values -%}
                {%- liquid
                  assign oi = forloop.index0
                  case oi
                    when 0
                      assign sel_val = crk_var.option1
                    when 1
                      assign sel_val = crk_var.option2
                    when 2
                      assign sel_val = crk_var.option3
                  endcase
                  assign wide = false
                  for val in option.values
                    assign vlen = val | size
                    if vlen > 3
                      assign wide = true
                    endif
                  endfor
                -%}
                <div class="crk-optgroup" data-crk-optgroup="{{ oi }}" data-crk-optname="{{ option.name | escape }}">
                  {%- comment -%}
                    Every option is named. Collapsing this to one heading above
                    the whole loop was a real defect: a tee is Colour AND Size,
                    so the page showed one heading and two anonymous rows of
                    buttons, and a shopper picking from the first row had no way
                    to know it was the colour. The size guide hangs off whichever
                    option is the size, not off the first one.
                  {%- endcomment -%}
                  <div class="crk-sizehead">
                    <span class="crk-label">{{ option.name }}</span>
                    {%- if has_measurements and option.name == crk_size_opt.name -%}
                      <button type="button" class="crk-sizeguide" data-crk-size-guide>
                        {{ section.settings.size_guide_label }}
                      </button>
                    {%- endif -%}
                  </div>
                  <div class="crk-sizes{% if wide %} crk-sizes--wide{% endif %}" role="group" aria-label="{{ option.name | escape }}">
                    {%- for value in option.values -%}
                      {%- liquid
                        assign is_sel = false
                        if value == sel_val
                          assign is_sel = true
                        endif
                      -%}
                      <button
                        type="button"
                        class="crk-size"
                        data-crk-opt="{{ oi }}"
                        data-value="{{ value | escape }}"
                        data-selected="{{ is_sel }}"
                        data-low="false"
                        aria-pressed="{{ is_sel }}"
                        aria-label="{{ option.name | escape }} {{ value | escape }}"
                      >{{ value }}</button>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endfor -%}

              {%- comment -%}
                Mirrors the JS states so the pre-JS render is accurate in all three
                cases: nothing chosen yet (the cold landing), a chosen size that is
                sold out (?variant=<sold out>, or the Back button), and a chosen size
                that is buyable. crooks-record.js reads the selection back out of
                these buttons on init, so leaving them all unselected here is what
                makes the shopper's first choice their own.
              {%- endcomment -%}
              <p class="crk-stockline" data-crk-stockline data-out="{% if crk_var and crk_var.available == false %}true{% else %}false{% endif %}" aria-live="polite">
                {%- if crk_var == blank -%}
                  {{ crk_select_label }}
                {%- elsif crk_var.available == false -%}
                  {{ section.settings.label_sold_size | replace: '[size]', crk_var.title }}
                {%- elsif crk_var.inventory_quantity > 0 and crk_var.inventory_quantity <= section.settings.low_stock_threshold -%}
                  {{ section.settings.label_low | replace: '[n]', crk_var.inventory_quantity | replace: '[size]', crk_var.title }}
                {%- else -%}
                  {{ section.settings.label_in_stock }}
                {%- endif -%}
              </p>

              <noscript>
                <p class="crk-micro" style="margin-top: 8px;">{{ section.settings.nojs_note }}</p>
                <ul class="crk-sizes crk-sizes--wide">
                  {%- for v in product.variants -%}
                    {%- if v.available -%}
                      <li><a class="crk-size" href="{{ product.url }}?variant={{ v.id }}">{{ v.title }}</a></li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              </noscript>
            {%- else -%}
              <p class="crk-stockline" data-crk-stockline data-out="false" aria-live="polite">
                {%- if crk_var.inventory_quantity > 0 and crk_var.inventory_quantity <= section.settings.low_stock_threshold -%}
                  {{ section.settings.label_low | replace: '[n]', crk_var.inventory_quantity | replace: ' IN SIZE [size]', '' }}
                {%- else -%}
                  {{ section.settings.label_in_stock }}
                {%- endif -%}
              </p>
            {%- endif -%}

            {%- comment -%}
              Delivery expectation, carried over from the Horizon PDP's
              delivery-message block. Real shipping information a customer needs
              before buying, so it survives the redesign rather than being
              replaced by flavour.
            {%- endcomment -%}
            {%- liquid
              assign crk_mto = false
              if product.tags contains section.settings.made_to_order_tag
                assign crk_mto = true
              endif
            -%}
            {%- comment -%}
              Hidden while the chosen variant is unavailable: "In stock · Ships within 24
              hours" sat two lines under "SIZE L IS SOLD OUT" and flatly contradicted it.
              JS re-evaluates on every size change; this covers the pre-JS render.
            {%- endcomment -%}
            {%- if crk_mto and section.settings.made_to_order_text != blank -%}
              <p class="crk-stockline" data-crk-delivery{% if crk_var and crk_var.available == false %} hidden{% endif %}>{{ section.settings.made_to_order_text }}</p>
            {%- elsif section.settings.in_stock_text != blank -%}
              <p class="crk-stockline" data-crk-delivery{% if crk_var and crk_var.available == false %} hidden{% endif %}>{{ section.settings.in_stock_text }}</p>

              {%- comment -%}
                Dispatch state readout. Deliberately NOT a countdown: a ticking clock is
                the one urgency pattern the brand rules out, and it is what makes a real
                shipping promise read as pressure selling. This is a status line in the
                same voice as "> 14 PRODUCTS AVAILABLE TO PURCHASE" — it reports a fact
                and stops.

                Computed client-side because Liquid's `now` is server-side and these
                pages are CDN-cached, so a server-rendered state would go stale and lie.
                With JS off nothing renders here and the static line above still carries
                the full, always-true promise.

                Config travels as data-* attributes — no Liquid inside a script tag.
              {%- endcomment -%}
              {%- if section.settings.dispatch_show -%}
                <p
                  class="crk-stockline crk-dispatch"
                  data-crk-dispatch
                  data-crk-cutoff="{{ section.settings.dispatch_cutoff_hour }}"
                  data-crk-dispatch-days="{{ section.settings.dispatch_days }}"
                  data-crk-tz="{{ section.settings.dispatch_timezone }}"
                  data-crk-today="{{ section.settings.dispatch_today | escape }}"
                  data-crk-tomorrow="{{ section.settings.dispatch_tomorrow | escape }}"
                  data-crk-nextopen="{{ section.settings.dispatch_next_open | escape }}"
                  data-crk-countdown="{{ section.settings.dispatch_countdown | escape }}"
                  data-crk-delivery="{{ section.settings.dispatch_delivery | escape }}"
                  hidden
                ></p>
              {%- endif -%}
            {%- endif -%}

            {%- comment -%}
              Complete-the-set toggle. Sits here by design: after the shopper
              knows what it is, that it is in stock and when it ships, and
              before the button. Renders only for products carrying the set
              metafields, collapsed, once per page.
            {%- endcomment -%}
            {%- render 'crooks-set-toggle', product: product, section: section -%}

            {%- comment -%} App blocks (size charts, reviews) render here. {%- endcomment -%}
            {%- for block in section.blocks -%}
              {%- if block.type == '@app' -%}
                <div {{ block.shopify_attributes }}>{% render block %}</div>
              {%- endif -%}
            {%- endfor -%}

            {%- comment -%}
              The buy spine carries no label. "Release request" sat above ADD TO
              BAG, which is the one place KEEP.md §2 says fiction must never go:
              "Never let ADD TO BAG become in-fiction. That rule is the reason
              the whole aesthetic survives contact with a stranger." The size
              row, price and button say what this is without a heading.
            {%- endcomment -%}
            {%- comment -%}
              Server-side buy state. Without this a JS-off shopper landing on
              ?variant=<sold out> got an enabled ADD TO BAG carrying that variant's id.
              JS re-derives all of this on first render, so this only governs the
              pre-JS and no-JS case. ADD TO BAG stays plain English either way.
            {%- endcomment -%}
            <button type="submit" name="add" class="crk-btn" data-crk-buy{% unless crk_var.available %} disabled{% endunless %}>
              {%- if crk_var.available == false -%}
                {{ section.settings.label_sold }}
              {%- elsif crk_var == blank and crk_has_options -%}
                {{ crk_select_label }}
              {%- else -%}
                {{ section.settings.label_add }}
              {%- endif -%}
            </button>

            {%- comment -%}
              Reassurance strip. Three facts, each a setting, each matching a
              policy that is already written on the terms page — the shipping
              threshold, the dispatch cutoff and the returns window. Any row
              left blank in the editor simply does not render, so this cannot
              become a place where a promise outlives the policy behind it.
            {%- endcomment -%}
            {%- liquid
              assign crk_reassure = 0
              if section.settings.reassure_1 != blank
                assign crk_reassure = crk_reassure | plus: 1
              endif
              if section.settings.reassure_2 != blank
                assign crk_reassure = crk_reassure | plus: 1
              endif
              if section.settings.reassure_3 != blank
                assign crk_reassure = crk_reassure | plus: 1
              endif
            -%}
            {%- if crk_reassure > 0 -%}
              <ul class="crk-reassure">
                {%- if section.settings.reassure_1 != blank -%}
                  <li><svg class="crk-reassure__ico" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M2 5l6-3 6 3v6l-6 3-6-3z"/><path d="M2 5l6 3 6-3M8 8v6"/></svg>{{ section.settings.reassure_1 }}</li>
                {%- endif -%}
                {%- if section.settings.reassure_2 != blank -%}
                  <li><svg class="crk-reassure__ico" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M9 1L3 9h4l-1 6 7-8H9z"/></svg>{{ section.settings.reassure_2 }}</li>
                {%- endif -%}
                {%- if section.settings.reassure_3 != blank -%}
                  <li><svg class="crk-reassure__ico" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M14 8a6 6 0 1 1-2.5-4.9"/><path d="M14 1v4h-4"/></svg>{{ section.settings.reassure_3 }}</li>
                {%- endif -%}
              </ul>
            {%- endif -%}

            {%- comment -%}
              Shopify's dynamic checkout. Its chrome is Shopify-owned and cannot be
              restyled — Shop Pay purple, PayPal blue — so it is framed rather than
              faked, the same treatment the cart gets. Deliberate trade: one-tap for
              anyone with saved details, at the cost of the only non-CROOKSLDN pixels
              in the buy panel. It disappears by itself when the variant is unbuyable.
            {%- endcomment -%}
            {%- if section.settings.show_dynamic_checkout -%}
              <div class="crk-buynow" data-crk-buynow{% unless crk_var.available %} hidden{% endunless %}>{{ form | payment_button }}</div>
            {%- endif -%}

            {%- comment -%}
              Add-to-bag confirmation. A readout, in the same voice as the dispatch
              line — no overlay, no drawer, nothing to dismiss. aria-live so it is
              announced rather than only seen.
            {%- endcomment -%}
            <p class="crk-stockline crk-added" data-crk-added aria-live="polite" hidden></p>
          {%- endform -%}

          {%- comment -%}
            Variant-level sold-out capture. The block below only ever rendered when EVERY
            variant was gone, so a shopper whose size is sold out while other sizes remain
            was offered nothing at all — the worst finding in the audit. Same component,
            same copy, surfaced at the right granularity. It sits outside the product form
            because HTML forbids nested forms, and starts hidden unless the variant the
            server selected is itself unavailable, so it is correct before JS runs.
          {%- endcomment -%}
          <div class="crk-notifypanel" data-crk-notify-panel{% unless crk_var and crk_var.available == false %} hidden{% endunless %}>
            {%- form 'contact', class: 'crk-notify' -%}
              <input type="hidden" name="contact[subject]" value="{{ section.settings.notify_subject | escape }}">
              <input type="hidden" name="contact[product]" value="{{ product.handle }}">
              <input type="hidden" name="contact[product_url]" value="{{ shop.url }}{{ product.url }}">
              <input type="hidden" name="contact[variant]" value="{{ crk_var.title | escape }}" data-crk-notify-variant>
              <label class="crk-label crk-buylabel" for="crk-notify-variant-email">{{ section.settings.notify_variant_label }}</label>
              <input
                class="crk-input"
                id="crk-notify-variant-email"
                type="email"
                name="contact[email]"
                placeholder="{{ section.settings.notify_placeholder | escape }}"
                autocomplete="email"
                required
              >
              <button class="crk-btn" type="submit" style="margin-top: 8px;">{{ section.settings.notify_button }}</button>
              {%- if form.posted_successfully? -%}
                <p class="crk-body" style="margin-top: 16px;" aria-live="polite">{{ section.settings.notify_ok }}</p>
              {%- elsif form.errors -%}
                <p class="crk-body" style="margin-top: 16px; color: var(--crk-red);" role="alert">{{ section.settings.notify_err }}</p>
              {%- endif -%}
            {%- endform -%}
          </div>
        {%- else -%}
          <p class="crk-stockline" data-out="true">{{ section.settings.released_text }}</p>
          {%- form 'contact', class: 'crk-notify' -%}
            <input type="hidden" name="contact[subject]" value="{{ section.settings.notify_subject | escape }}">
            <input type="hidden" name="contact[product]" value="{{ product.handle }}">
            <input type="hidden" name="contact[product_url]" value="{{ shop.url }}{{ product.url }}">
            {%- comment -%}
              This input's accessible name came from buy_label. That setting is
              gone from the buy spine, so the field gets a label of its own —
              KEEP.md §4 records "interactive controls with no accessible name:
              0 of 35", and that number stays 0.
            {%- endcomment -%}
            <label class="crk-sr" for="crk-notify-email">{{ section.settings.notify_email_label }}</label>
            <input
              class="crk-input"
              id="crk-notify-email"
              type="email"
              name="contact[email]"
              placeholder="{{ section.settings.notify_placeholder | escape }}"
              autocomplete="email"
              required
            >
            <button class="crk-btn" type="submit" style="margin-top: 8px;">{{ section.settings.notify_button }}</button>
            {%- if form.posted_successfully? -%}
              <p class="crk-body" style="margin-top: 16px;" aria-live="polite">{{ section.settings.notify_ok }}</p>
            {%- elsif form.errors -%}
              <p class="crk-body" style="margin-top: 16px; color: var(--crk-red);" role="alert">{{ section.settings.notify_err }}</p>
            {%- endif -%}
          {%- endform -%}
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} ---------- collapsible record sections ---------- {%- endcomment -%}
    <div class="crk-stack">
      <div>
        {%- liquid
          assign spec_count = 0
          if crk_single
            assign spec_count = 1
          endif
          if mf.fabric.value != blank
            assign spec_count = spec_count | plus: 1
          endif
          if mf.cut.value != blank
            assign spec_count = spec_count | plus: 1
          endif
          if mf.wash_code.value != blank
            assign spec_count = spec_count | plus: 1
          endif
          if mf.origin.value != blank
            assign spec_count = spec_count | plus: 1
          endif
          if mf.care.value != blank
            assign spec_count = spec_count | plus: 1
          endif
          if mf.case_ref.value != blank
            assign spec_count = spec_count | plus: 1
          endif
        -%}
        {%- comment -%}
          Shipping and returns first. The delivery window was the third block
          inside the fourth panel, and "when will it arrive" is the second
          question every shopper has after the price. It now opens the list.
        {%- endcomment -%}
        {%- if section.blocks.size > 0 -%}
          <section class="crk-section" id="crk-custody">
            <h2 class="crk-display crk-h" style="margin: 0;">
              <button type="button" class="crk-section-head" data-crk-accordion aria-expanded="{% if section.settings.custody_open %}true{% else %}false{% endif %}" aria-controls="crk-custody-body">
                <span class="crk-display crk-h">{{ section.settings.custody_heading }}</span>
                <span class="crk-display crk-h" aria-hidden="true" data-crk-accordion-icon>{% if section.settings.custody_open %}−{% else %}+{% endif %}</span>
              </button>
            </h2>
            <div class="crk-section-body" id="crk-custody-body"{% unless section.settings.custody_open %} hidden{% endunless %}>
              {%- if settings.crk_ret_on_product -%}{{ 'crooks-returns.css' | asset_url | stylesheet_tag }}{%- endif -%}
              <ol class="crk-custody">
                {%- for block in section.blocks -%}
                  {%- if block.type != 'custody_step' -%}{%- continue -%}{%- endif -%}
                  <li {{ block.shopify_attributes }}>
                    <span class="crk-label">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }} {{ block.settings.label }}</span>
                    <p class="crk-body">{{ block.settings.body }}</p>
                  </li>
                {%- endfor -%}
                {%- comment -%}
                  Returns close the chain: after Delivered, what happens if it doesn't
                  fit. Here rather than under the buy button, so it reassures without
                  pitching a return. Wording: Theme settings → CROOKS — Returns promise.
                {%- endcomment -%}
                {%- if settings.crk_ret_on_product -%}
                  {%- assign crk_ret_step = section.blocks.size | plus: 1 -%}
                  {%- render 'crooks-returns-promise', variant: 'custody', step: crk_ret_step -%}
                {%- endif -%}
              </ol>
            </div>
          </section>
        {%- endif -%}

        {%- comment -%}
          George, 2026-08-31: "for now remove specification for products and
          just keep the item description." Switched off rather than deleted —
          the rows, the settings and the metafields are all untouched, so
          turning it back on is one checkbox in the theme editor.
        {%- endcomment -%}
        {%- if spec_count > 0 and section.settings.spec_show -%}
          <section class="crk-section" id="crk-specification">
            <h2 class="crk-display crk-h" style="margin: 0;">
              <button type="button" class="crk-section-head" data-crk-accordion aria-expanded="{% if section.settings.spec_open %}true{% else %}false{% endif %}" aria-controls="crk-specification-body">
                <span class="crk-display crk-h">{{ section.settings.spec_heading }}</span>
                <span class="crk-display crk-h" aria-hidden="true" data-crk-accordion-icon>{% if section.settings.spec_open %}−{% else %}+{% endif %}</span>
              </button>
            </h2>
            <div class="crk-section-body" id="crk-specification-body"{% unless section.settings.spec_open %} hidden{% endunless %}>
              <dl class="crk-spec">
                {%- if crk_single -%}<dt>{{ section.settings.row_size }}</dt><dd>{{ section.settings.one_size_text }}</dd>{%- endif -%}
                {%- if mf.fabric.value != blank -%}<dt>{{ section.settings.row_fabric }}</dt><dd>{{ mf.fabric.value }}</dd>{%- endif -%}
                {%- if mf.cut.value != blank -%}<dt>{{ section.settings.row_cut }}</dt><dd>{{ mf.cut.value }}</dd>{%- endif -%}
                {%- if mf.wash_code.value != blank -%}<dt>{{ section.settings.row_wash }}</dt><dd>{{ mf.wash_code.value }}</dd>{%- endif -%}
                {%- if mf.origin.value != blank -%}<dt>{{ section.settings.row_origin }}</dt><dd>{{ mf.origin.value }}</dd>{%- endif -%}
                {%- if mf.care.value != blank -%}<dt>{{ section.settings.row_care }}</dt><dd>{{ mf.care.value }}</dd>{%- endif -%}
                {%- if mf.case_ref.value != blank -%}<dt>{{ section.settings.row_case }}</dt><dd>{{ mf.case_ref.value }}</dd>{%- endif -%}
              </dl>
            </div>
          </section>
        {%- endif -%}

        {%- if product.description != blank -%}
          <section class="crk-section" id="crk-provenance">
            <h2 class="crk-display crk-h" style="margin: 0;">
              <button type="button" class="crk-section-head" data-crk-accordion aria-expanded="{% if section.settings.provenance_open %}true{% else %}false{% endif %}" aria-controls="crk-provenance-body">
                <span class="crk-display crk-h">{{ section.settings.provenance_heading }}</span>
                <span class="crk-display crk-h" aria-hidden="true" data-crk-accordion-icon>{% if section.settings.provenance_open %}−{% else %}+{% endif %}</span>
              </button>
            </h2>
            <div class="crk-section-body" id="crk-provenance-body"{% unless section.settings.provenance_open %} hidden{% endunless %}>
              <div class="crk-body">{{ product.description }}</div>
            </div>
          </section>
        {%- endif -%}

        {%- if crk_show_measure -%}
          <section class="crk-section" id="crk-measurements">
            <h2 class="crk-display crk-h" style="margin: 0;">
              <button type="button" class="crk-section-head" data-crk-accordion aria-expanded="{% if section.settings.measure_open %}true{% else %}false{% endif %}" aria-controls="crk-measurements-body">
                <span class="crk-display crk-h">{{ section.settings.measure_heading }}</span>
                <span class="crk-display crk-h" aria-hidden="true" data-crk-accordion-icon>{% if section.settings.measure_open %}−{% else %}+{% endif %}</span>
              </button>
            </h2>
            <div class="crk-section-body" id="crk-measurements-body"{% unless section.settings.measure_open %} hidden{% endunless %}>
              <div class="crk-units" role="group" aria-label="{{ section.settings.units_label | escape }}">
                <button type="button" class="crk-unit" data-crk-unit="cm" data-selected="true" aria-pressed="true">{{ section.settings.unit_cm }}</button>
                <button type="button" class="crk-unit" data-crk-unit="in" data-selected="false" aria-pressed="false">{{ section.settings.unit_in }}</button>
              </div>
              {%- if has_measurements -%}
                {%- render 'crooks-measure-table',
                    rows: rows,
                    caption_cm: section.settings.measure_caption_cm,
                    caption_in: section.settings.measure_caption_in,
                    region_label: section.settings.measure_region_label -%}
              {%- else -%}
                {%- for crk_part in crk_parts -%}
                  {%- render 'crooks-measure-table',
                      rows: crk_part.metafields.crooks.measurements.value,
                      caption_cm: section.settings.measure_caption_cm,
                      caption_in: section.settings.measure_caption_in,
                      region_label: section.settings.measure_region_label,
                      piece: crk_part.title -%}
                {%- endfor -%}
              {%- endif -%}
            </div>
          </section>
        {%- endif -%}

      </div>

      {%- comment -%} ---------- filed under the same case ---------- {%- endcomment -%}
      {%- liquid
        assign related = ''
        assign related_n = 0
        for p in crk_col.products
          if p.metafields.crooks.set_components
            continue
          endif
          if p.id != product.id and p.type == product.type and related_n < 4
            assign related = related | append: p.handle | append: '|'
            assign related_n = related_n | plus: 1
          endif
        endfor
      -%}
      {%- if related_n >= 2 -%}
        <section>
          <h2 class="crk-display crk-h">{{ section.settings.related_heading }}</h2>
          <div class="crk-related">
            {%- assign handles = related | split: '|' -%}
            {%- for h in handles -%}
              {%- if h != blank -%}
                {%- assign rp = all_products[h] -%}
                {%- if rp.id -%}
                  <a href="{{ rp.url }}" class="crk-related-item">
                    <span class="crk-tray crk-related-tray">
                      {{ rp.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: rp.title }}
                    </span>
                    <span class="crk-data">{% render 'crooks-title', product: rp %}</span>
                    <span class="crk-display" style="font-size: 18px;">{{ rp.price | money }}</span>
                    {%- comment -%}
                      The rail used to know one thing: gone entirely. A piece
                      with two of five sizes left looked as buyable here as a
                      full one, which is the same blindness the register cards
                      were fixed for. Same snippet, so they cannot drift apart.
                      The available label is deliberately empty — a rail that
                      says AVAILABLE under every card is noise; this only speaks
                      when there is something to warn about.
                    {%- endcomment -%}
                    {%- render 'crooks-sizes-left',
                      product: rp,
                      class: 'crk-related-soldout',
                      sizes_left_label: section.settings.related_sizes_label,
                      sold_label: section.settings.label_sold,
                      available_label: ''
                    -%}
                  </a>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        </section>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} ---------- sticky bar: mobile only, one instance ---------- {%- endcomment -%}
  {%- if product.available -%}
    <div class="crk-sticky-spacer" aria-hidden="true" hidden data-crk-sticky-spacer></div>
    <div class="crk-stickybar" data-crk-buybar hidden>
      <div style="min-width: 0; flex: 1;">
        <div class="crk-display" style="font-size: 18px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
          {% render 'crooks-title', product: product %}
        </div>
        <div class="crk-data crk-dim" data-crk-sticky-meta>{{ crk_price_display }}</div>
      </div>
      {%- comment -%}
        Two actions, mirroring the panel. The bar sits outside the product form, so
        it cannot host a payment_button — Shopify only renders those inside one.
        Its CHECKOUT NOW is therefore a theme button that adds and goes straight to
        checkout: same destination, different mechanism from the wallet row above.
      {%- endcomment -%}
      {%- comment -%}
        One action. CHECKOUT NOW was a second, competing button in a bar the
        width of a phone; the brief asks for a single wide control and the
        express lane still exists in the panel above.
      {%- endcomment -%}
      <div class="crk-buybar__actions">
        <button type="button" class="crk-btn" data-crk-sticky-add>{{ section.settings.label_add }}</button>
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Crooks — Product Record",
  "tag": "section",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection for product numbering, related items and the back link" },
    { "type": "text", "id": "back_label", "label": "Back link label", "default": "← Catalogue" },
    { "type": "text", "id": "exhibit_word", "label": "Product word", "default": "PRODUCT" },
    { "type": "text", "id": "case_word", "label": "Case word", "default": "CASE" },
    { "type": "checkbox", "id": "show_texture", "label": "Show scanline texture", "default": true },
    { "type": "header", "content": "Gallery" },
    { "type": "text", "id": "photo_label", "label": "Photo counter", "info": "Use [i] and [n].", "default": "[i] / [n]" },
    { "type": "text", "id": "gallery_label", "label": "Gallery group label (screen readers)", "default": "Evidence photographs" },
    { "type": "header", "content": "Buying" },
    { "type": "text", "id": "size_group_label", "label": "Size group label (screen readers)", "default": "Select a size" },
    { "type": "text", "id": "label_add", "label": "Add to bag", "info": "[price] is replaced with the selected variant's price, formatted by Shopify in the shopper's currency. Remove the token and the button simply reads as written.", "default": "ADD TO BAG \u2014 [price]" },
    { "type": "text", "id": "label_checkout_now", "label": "Checkout now", "default": "Checkout now" },
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show Shopify dynamic checkout (Shop Pay etc.)", "info": "Shopify-owned chrome; cannot be restyled.", "default": true },
    { "type": "text", "id": "label_added", "label": "Added confirmation", "info": "Use [n] for the bag count.", "default": "Added — [n] in bag" },
    { "type": "text", "id": "label_added_plain", "label": "Added confirmation, count unavailable", "info": "Shown when the item went in but the bag count could not be read back.", "default": "Added to bag" },
    { "type": "text", "id": "label_adding", "label": "While adding", "info": "Shown on the button between the tap and the cart answering. On a slow connection this is the only sign the tap registered.", "default": "Adding\u2026" },
    { "type": "text", "id": "label_add_error", "label": "Add failed", "default": "Could not add that. Refresh and try again." },
    { "type": "text", "id": "label_view_bag", "label": "View bag link", "default": "View bag" },
    { "type": "text", "id": "label_select", "label": "No option chosen", "default": "Select a size" },
    { "type": "text", "id": "label_select_option", "label": "Prompt naming the missing option", "info": "Use [option].", "default": "Select [option]" },
    { "type": "text", "id": "label_sold", "label": "Sold out", "default": "SOLD OUT" },
    { "type": "text", "id": "label_in_stock", "label": "In stock line", "default": "IN STOCK" },
    { "type": "text", "id": "label_low", "label": "Low stock line", "info": "Use [n] and [size].", "default": "[n] LEFT IN SIZE [size]" },
    { "type": "text", "id": "label_sold_size", "label": "Sold out size line", "info": "Use [size].", "default": "SIZE [size] IS SOLD OUT" },
    { "type": "range", "id": "low_stock_threshold", "label": "Low stock threshold", "min": 1, "max": 10, "step": 1, "default": 3 },
    { "type": "text", "id": "size_head_label", "label": "Size row label", "info": "Used only when the product option has no name of its own.", "default": "SIZE" },
    { "type": "text", "id": "size_guide_label", "label": "Size guide button", "default": "SIZE GUIDE" },
    { "type": "text", "id": "sr_sold_out", "label": "\"Sold out\" (screen readers)", "default": "sold out" },
    { "type": "text", "id": "sr_left", "label": "\"left\" (screen readers)", "default": "left" },
    { "type": "text", "id": "nojs_note", "label": "No-JavaScript note", "default": "CHOOSE A SIZE:" },
    { "type": "header", "content": "Delivery" },
    { "type": "text", "id": "in_stock_text", "label": "In-stock delivery line", "default": "Order before 18:00 and it ships today (Mon–Sat)" },
    { "type": "text", "id": "made_to_order_text", "label": "Made-to-order delivery line", "default": "Made to order · Ships in 9–16 days" },
    { "type": "text", "id": "made_to_order_tag", "label": "Made-to-order tag", "default": "made-to-order" },
    { "type": "header", "content": "Dispatch cutoff" },
    { "type": "checkbox", "id": "dispatch_show", "label": "Show the dispatch state line", "info": "A status line under the delivery line. Never a countdown.", "default": true },
    { "type": "range", "id": "dispatch_cutoff_hour", "label": "Cutoff hour (24h, shop time)", "min": 0, "max": 23, "step": 1, "unit": "h", "default": 18 },
    { "type": "text", "id": "dispatch_days", "label": "Dispatch days", "info": "Day numbers, 1 = Monday. Mon-Sat is 1,2,3,4,5,6.", "default": "1,2,3,4,5,6" },
    { "type": "text", "id": "dispatch_timezone", "label": "Shop timezone", "info": "IANA name. The cutoff is judged in this zone, not the shopper's.", "default": "Europe/London" },
    { "type": "text", "id": "dispatch_today", "label": "Before cutoff, on a dispatch day", "default": "Ordered now \u2014 leaves today" },
    { "type": "text", "id": "dispatch_tomorrow", "label": "After cutoff, next day is a dispatch day", "default": "Ordered now \u2014 leaves tomorrow" },
    { "type": "text", "id": "dispatch_countdown", "label": "Countdown line", "info": "Shown before the cut-off. [t] is replaced by the live time remaining, counted against the shop timezone below \u2014 never the visitor's device clock.", "default": "ORDER WITHIN [t] \u2014 DISPATCHED TODAY" },
    { "type": "text", "id": "dispatch_delivery", "label": "Delivery estimate", "info": "Second line, shown in every state. Leave blank to hide it.", "default": "UK DELIVERY IN 1\u20133 WORKING DAYS" },
    { "type": "text", "id": "dispatch_next_open", "label": "Otherwise (closed tomorrow)", "default": "Ordered now \u2014 leaves Monday" },
    { "type": "header", "content": "Sold out" },
    { "type": "text", "id": "released_text", "label": "Released text", "default": "RELEASED — NO LONGER IN CUSTODY" },
    { "type": "text", "id": "notify_variant_label", "label": "Notify label (size sold out)", "default": "Tell me when this size is back" },
    { "type": "text", "id": "notify_placeholder", "label": "Notify placeholder", "default": "email address" },
    { "type": "text", "id": "notify_button", "label": "Notify button", "default": "Notify me" },
    { "type": "text", "id": "notify_email_label", "label": "Notify email field label (screen readers)", "default": "Email address" },
    { "type": "text", "id": "notify_subject", "label": "Notify email subject", "default": "Restock request" },
    { "type": "text", "id": "notify_ok", "label": "Notify success", "default": "Logged. We will email you when this exhibit returns." },
    { "type": "text", "id": "notify_err", "label": "Notify error", "default": "Submission rejected — check the address." },
    { "type": "header", "content": "Header, fit and reassurance" },
    { "type": "paragraph", "content": "The rating row renders only when a review app has written Shopify's reviews.rating and reviews.rating_count metafields. With no reviews there is no row \u2014 stars are never drawn from nothing. Subtitle and fit come from crooks.subtitle, crooks.fit, crooks.model_height and crooks.model_size; any that are empty are skipped." },
    { "type": "text", "id": "reviews_label", "label": "Reviews word", "default": "REVIEWS" },
    { "type": "text", "id": "rating_sr", "label": "Rating, screen readers", "info": "Reads as \"4.8 out of 5\".", "default": "out of" },
    { "type": "text", "id": "fit_model_template", "label": "Model line", "info": "[height] and [size] are replaced by the product's own metafields. Rendered only when both are filled in.", "default": "MODEL [height] WEARS [size]" },
    { "type": "text", "id": "reassure_1", "label": "Reassurance 1", "default": "FREE UK DELIVERY" },
    { "type": "text", "id": "reassure_2", "label": "Reassurance 2", "default": "SAME-DAY DISPATCH" },
    { "type": "text", "id": "reassure_3", "label": "Reassurance 3", "default": "14-DAY RETURNS" },

    { "type": "header", "content": "Specification" },
    { "type": "checkbox", "id": "spec_show", "label": "Show the Specification panel", "default": false, "info": "Off hides the whole panel. Fabric, cut, wash, origin, care and case reference stay on the products \u2014 nothing is deleted." },
    { "type": "text", "id": "spec_heading", "label": "Heading", "default": "Specification" },
    { "type": "text", "id": "row_size", "label": "Size row", "default": "Size" },

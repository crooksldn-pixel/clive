{{ 'crooks.css' | asset_url | stylesheet_tag }}
<script src="{{ 'crooks-drawer.js' | asset_url }}" defer></script>
<script src="{{ 'crooks-bag.js' | asset_url }}" defer></script>
<script src="{{ 'crooks-theme.js' | asset_url }}" defer></script>

{%- assign crk_menu = linklists[section.settings.menu] -%}

{%- comment -%}
  The bag counts GARMENTS, not cart lines. A bundle is one line holding two
  pieces, so `cart.item_count` read BAG [1] for a set and BAG [2] for the same
  two garments bought separately. crooks-bag-count owns that rule; the header
  only prints what it returns.
{%- endcomment -%}
{%- capture crk_cart_count -%}{%- render 'crooks-bag-count' -%}{%- endcapture -%}

{%- comment -%}
  The uploaded mark is a black silhouette on transparency, so on the near-black
  ground it is invisible. The attribute drives a CSS invert in dark mode only.
  It is a setting because inverting a COLOUR logo would wreck it — anyone who
  uploads one turns this off rather than editing CSS.
{%- endcomment -%}
{%- comment -%}
  crooks-board.js is NOT loaded here. It used to be, on every page of the site,
  to power the canvas in the menu drawer — and audit run 3 caught INP doubling
  (~600ms -> ~1,050ms) from that change. The board auto-mounts on DOMContentLoaded
  and schedules a frame before its IntersectionObserver can stop it, so every page
  paid for a 1,100-fillRect frame nobody could see.

  The URL rides on the header as data, and crooks-drawer.js injects the script on
  the first menu open. The board and its pause guards are untouched (KEEP §1) —
  this is about WHEN the code loads, not what it does.
{%- endcomment -%}
<header
  class="crk-root crk-header"
  data-crk-section="header"
  data-crk-bag-count-url="{{ routes.cart_url }}?view=crk-count"
  {% if section.settings.show_case and section.settings.case_url != blank %}data-crk-board-src="{{ 'crooks-board.js' | asset_url }}"{% endif %}
  {% if section.settings.logo_invert_dark %}data-crk-logo-invert="true"{% endif %}
  data-crk-sticky="{{ section.settings.sticky_top }}"
>
  <div class="crk-header__bar">
    <a class="crk-header__logo" href="{{ routes.root_url }}">
      {%- if section.settings.logo != blank -%}
        {{
          section.settings.logo
          | image_url: width: 400
          | image_tag: widths: '100, 200, 300, 400', alt: shop.name, loading: 'eager'
        }}
      {%- else -%}
        {{ section.settings.wordmark | default: shop.name }}
      {%- endif -%}
    </a>

    <div class="crk-header__actions">
      {%- comment -%}
        Catalogue sits first in the actions row, to the left of search: it is the
        main browse destination and the homepage CTA uses the same word. A link,
        not a menu item — the nav menu is merchant data and this is chrome.
      {%- endcomment -%}
      {%- if section.settings.show_catalogue and section.settings.catalogue_url != blank -%}
        <a class="crk-header__link crk-header__link--catalogue" href="{{ section.settings.catalogue_url }}">{{ section.settings.catalogue_label }}</a>
      {%- endif -%}

      {%- comment -%}
        Featured link beside the catalogue, for a drop like T-shirt Week. Off by
        default, so it only shows where the header group switches it on. Each
        word is kept whole, so on a phone it stacks as T-SHIRT over WEEK rather
        than breaking at the hyphen.
      {%- endcomment -%}
      {%- if section.settings.show_feature and section.settings.feature_url != blank -%}
        {%- assign crk_feature_words = section.settings.feature_label | split: ' ' -%}
        <a class="crk-header__link crk-header__link--feature" href="{{ section.settings.feature_url }}">
          <span class="crk-header__words">
            {%- for word in crk_feature_words -%}
              <span>{{ word }}</span>{% unless forloop.last %} {% endunless %}
            {%- endfor -%}
          </span>
        </a>
      {%- endif -%}

      {%- comment -%}
        Search is a glyph rather than the word, which is what buys the room for
        the rest of the row on a phone. The label is not deleted, it moves to
        the accessible name, so a screen reader still hears "SEARCH" and the
        setting still controls what it says.
      {%- endcomment -%}
      {%- if section.settings.show_search -%}
        <a class="crk-header__link crk-header__link--icon" href="{{ routes.search_url }}">
          <svg class="crk-header__glyph" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
            <circle cx="8.5" cy="8.5" r="5.5" stroke="currentColor" stroke-width="1.5"/>
            <path d="M12.7 12.7 L17.5 17.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/>
          </svg>
          <span class="crk-sr">{{ section.settings.search_label }}</span>
        </a>
      {%- endif -%}

      {%- comment -%}
        Cart is never hidden behind the drawer — it is a sale-critical control.
      {%- endcomment -%}
      <a class="crk-header__link" href="{{ routes.cart_url }}">
        {{ section.settings.cart_label }}
        <span class="crk-header__count" data-crk-cart-count>&nbsp;[{{ crk_cart_count }}]</span>
      </a>

      {%- if section.settings.show_theme_toggle -%}
        {%- comment -%}
          Light/dark switch. Hidden until JS upgrades it so it is never a dead
          control; the label states what it will do, per the prototype.
        {%- endcomment -%}
        <button
          class="crk-header__link crk-header__link--theme"
          type="button"
          hidden
          data-crk-theme-toggle
          data-crk-to-light="{{ section.settings.label_to_light | escape }}"
          data-crk-to-dark="{{ section.settings.label_to_dark | escape }}"
          aria-pressed="false"
        >{{ section.settings.label_to_light }}</button>
      {%- endif -%}

      {%- comment -%}
        Text trigger, not a hamburger. Hidden until JS upgrades it, so it can
        never be a dead control; the <noscript> menu below covers that case.
      {%- endcomment -%}
      <button
        class="crk-header__link"
        type="button"
        hidden
        data-crk-drawer-open
        data-crk-label-open="{{ section.settings.menu_label | escape }}"
        data-crk-label-close="{{ section.settings.close_label | escape }}"
        aria-controls="crk-drawer"
        aria-expanded="false"
      >{{ section.settings.menu_label }}</button>
    </div>
  </div>

  {%- comment -%} Without JS the drawer cannot open, so render the menu inline. {%- endcomment -%}
  <noscript>
    <div class="crk-header__nofallback">
      <ul>
        {%- for link in crk_menu.links -%}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
        {%- endfor -%}
      </ul>
    </div>
  </noscript>

  <div
    class="crk-drawer"
    id="crk-drawer"
    data-crk-drawer
    role="dialog"
    aria-modal="true"
    aria-label="{{ section.settings.drawer_label | escape }}"
    hidden
  >
    <div class="crk-drawer__scrim" data-crk-drawer-close></div>
    <div class="crk-drawer__panel">
      <div class="crk-drawer__head">
        <p class="crk-eyebrow">{{ section.settings.drawer_heading }}</p>
        <button class="crk-header__link" type="button" data-crk-drawer-close>
          {{ section.settings.close_label }}
        </button>
      </div>

      <nav class="crk-drawer__nav" aria-label="{{ section.settings.drawer_label | escape }}">
        <ul>
          {%- comment -%}
            A parent keeps its own link and gains a separate disclosure button
            beside it. SHOP goes to /collections/frontpage and its ALL child
            goes to /collections/all — different places — so turning the parent
            row into a pure toggle would quietly drop a route.

            The submenu is rendered OPEN with aria-expanded="true"; the script
            closes it on load. That way the markup never depends on JS to be
            truthful, and the drawer is hidden until opened, so nobody sees it
            close. Without JS the drawer cannot open at all, which is what the
            <noscript> menu above is for.
          {%- endcomment -%}
          {%- for link in crk_menu.links -%}
            <li class="crk-drawer__item">
              {%- if link.links.size > 0 -%}
                {%- assign crk_sub_id = 'crk-submenu-' | append: section.id | append: '-' | append: forloop.index -%}
                <span class="crk-drawer__row">
                  <a class="crk-drawer__link" href="{{ link.url }}">{{ link.title }}</a>
                  <button
                    type="button"
                    class="crk-drawer__toggle"
                    aria-expanded="true"
                    aria-controls="{{ crk_sub_id }}"
                    data-crk-submenu-toggle
                  >
                    <span class="crk-sr" data-crk-submenu-say
                      data-crk-open-label="{{ section.settings.submenu_open_label | replace: '[title]', link.title | escape }}"
                      data-crk-close-label="{{ section.settings.submenu_close_label | replace: '[title]', link.title | escape }}"
                    >{{ section.settings.submenu_close_label | replace: '[title]', link.title }}</span>
                    <span class="crk-drawer__mark" aria-hidden="true"></span>
                  </button>
                </span>
                <ul class="crk-drawer__sub" id="{{ crk_sub_id }}" data-crk-submenu>
                  {%- for child in link.links -%}
                    <li><a class="crk-drawer__link" href="{{ child.url }}">{{ child.title }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- else -%}
                <a class="crk-drawer__link" href="{{ link.url }}">{{ link.title }}</a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </nav>

      {%- render 'crooks-app-install', placement: 'drawer' -%}

      {%- comment -%}
        CASE 001 lived in a full-width box on the homepage. Moved here: the
        drawer had dead space between the last menu item and the account/cart
        row, and a game promo is exactly the kind of thing that belongs in a
        menu rather than between the catalogue and the manifest.

        One anchor wraps the whole panel, so the CTA underneath is a styled
        span rather than a second interactive element inside a link.
      {%- endcomment -%}
      {%- if section.settings.show_case and section.settings.case_url != blank -%}
        <a
          class="crk-drawer__case"
          href="{{ section.settings.case_url }}"
          {% if section.settings.case_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
        >
          <span class="crk-drawer__case-art">
            <canvas class="crk-board crk-drawer__case-board" data-crk-board aria-hidden="true"></canvas>
          </span>
          <span class="crk-btn crk-btn--fill crk-drawer__case-cta">{{ section.settings.case_cta }}</span>
          <span class="crk-sr">{{ section.settings.case_caption }}</span>
        </a>
      {%- endif -%}

      <div class="crk-drawer__foot">
        {%- comment -%}
          The header row drops the light/dark switch below 768px to make room,
          so it appears here instead rather than being taken away from phones.
          crooks-theme.js relabels every toggle on the page when the theme
          changes, so the two stay in step.
        {%- endcomment -%}
        {%- if section.settings.show_theme_toggle -%}
          <button
            class="crk-header__link crk-drawer__theme"
            type="button"
            hidden
            data-crk-theme-toggle
            data-crk-to-light="{{ section.settings.label_to_light | escape }}"
            data-crk-to-dark="{{ section.settings.label_to_dark | escape }}"
            aria-pressed="false"
          >{{ section.settings.label_to_light }}</button>
        {%- endif -%}
        {%- if shop.customer_accounts_enabled -%}
          <a class="crk-header__link" href="{{ routes.account_url }}">{{ section.settings.account_label }}</a>
        {%- endif -%}
        <a class="crk-header__link" href="{{ routes.cart_url }}">
          {{ section.settings.cart_label }}<span data-crk-cart-count>&nbsp;[{{ crk_cart_count }}]</span>
        </a>
      </div>
    </div>
  </div>
</header>

{% stylesheet %}
  /* Featured link (crooks-header): lavender so the drop stands out from SHOP.
     Phones stack its words, which keeps the row inside 360px. */
  .crk-header .crk-header__link--feature { color: var(--crk-lav) }
  .crk-header__words > span { white-space: nowrap }
  @media (max-width: 479px) {
    .crk-header__words { width: min-content; line-height: 1.3; text-align: center }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Crooks — Header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo", "info": "Leave empty to use the wordmark text below." },
    { "type": "checkbox", "id": "logo_invert_dark", "label": "Flip logo to light in dark mode", "info": "For a dark, single-colour logo on a transparent background. Turn off for a colour logo.", "default": true },
    { "type": "text", "id": "wordmark", "label": "Wordmark", "default": "CROOKSLDN" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "header", "content": "Labels" },
    { "type": "text", "id": "menu_label", "label": "Menu button (closed)", "default": "MENU" },
    { "type": "text", "id": "close_label", "label": "Menu button (open)", "default": "CLOSE" },
    { "type": "text", "id": "cart_label", "label": "Cart label", "default": "BAG" },
    { "type": "checkbox", "id": "show_catalogue", "label": "Show the catalogue link", "default": true },
    { "type": "text", "id": "catalogue_label", "label": "Catalogue label", "default": "CATALOGUE" },
    { "type": "url", "id": "catalogue_url", "label": "Catalogue link", "info": "Shopify rejects a shopify:// default on a url setting, so the value is set on the header group rather than here." },
    { "type": "checkbox", "id": "show_feature", "label": "Show a featured link beside the catalogue", "default": false },
    { "type": "text", "id": "feature_label", "label": "Featured link label", "default": "T-SHIRT WEEK" },
    { "type": "url", "id": "feature_url", "label": "Featured link" },
    { "type": "text", "id": "search_label", "label": "Search label", "default": "SEARCH" },
    { "type": "text", "id": "account_label", "label": "Account label", "default": "ACCOUNT" },
    { "type": "text", "id": "drawer_heading", "label": "Drawer heading", "default": "MENU" },
    { "type": "text", "id": "drawer_label", "label": "Drawer label (screen readers)", "default": "Main menu" },
    { "type": "text", "id": "submenu_open_label", "label": "Expand submenu (screen readers)", "info": "Use [title] for the menu name.", "default": "Show [title] links" },
    { "type": "text", "id": "submenu_close_label", "label": "Collapse submenu (screen readers)", "info": "Use [title] for the menu name.", "default": "Hide [title] links" },
    { "type": "header", "content": "Case 001 (menu drawer)" },
    { "type": "checkbox", "id": "show_case", "label": "Show the case panel in the menu", "default": true },
    { "type": "text", "id": "case_caption", "label": "Panel description (screen readers)", "default": "CASE 001: THE GETAWAY. Animated map: a thief moves through an alley grid collecting coins while a patrolling officer crosses below." },
    { "type": "text", "id": "case_cta", "label": "Button label", "default": "PLAY CASE:001 NOW" },
    { "type": "url", "id": "case_url", "label": "Case link" },
    { "type": "checkbox", "id": "case_new_tab", "label": "Open in a new tab", "default": true },
    { "type": "header", "content": "Options" },
    { "type": "checkbox", "id": "sticky_top", "label": "Pin the top of the page while scrolling", "info": "Keeps the shipping line and the nav in view as the page moves. Turn off and they scroll away with everything else.", "default": true },
    { "type": "checkbox", "id": "show_search", "label": "Show search link", "default": true },
    { "type": "checkbox", "id": "show_theme_toggle", "label": "Show light/dark toggle", "default": true },
    { "type": "text", "id": "label_to_light", "label": "Label when dark (switches to light)", "default": "LIGHT MODE" },
    { "type": "text", "id": "label_to_dark", "label": "Label when light (switches to dark)", "default": "DARK MODE" }
  ],
  "presets": [{ "name": "Crooks — Header" }]
}
{% endschema %}

      "default": "<p>Wrong size? Swap it free. Changed your mind? Take store credit with a bonus on top. You have 14 days from delivery.</p>"
    },
    {
      "type": "text",
      "id": "endpoint",
      "label": "Returns service path",
      "info": "The app proxy path. Leave as /apps/returns/api unless the app proxy changes.",
      "default": "/apps/returns/api"
    },
    {
      "type": "url",
      "id": "contact_url",
      "label": "Contact page"
    },
    {
      "type": "color",
      "id": "accent",

{{ 'crooks.css' | asset_url | stylesheet_tag }}
<script src="{{ 'crooks-terminal.js' | asset_url }}" defer></script>
<script src="{{ 'crooks-quickadd.js' | asset_url }}" defer></script>

{%- liquid
  comment
    Source: the collection being viewed when this renders on a collection template,
    otherwise the one chosen in the section settings. `collection` is only defined
    on collection templates, so the homepage is unaffected and needs no setting.

    Without this, /collections/denim would render whatever fixed collection the
    section was configured with — every category page showing the same products.
  endcomment
  assign crk_col = collections[section.settings.collection]
  if collection and collection.handle != blank
    assign crk_col = collection
  endif
  assign crk_products = crk_col.products

  comment
    Search results are products too, so the register renders them rather than
    handing the page back to Horizon. search.results can also contain articles and
    pages; those are skipped in the card loop, and counted out here so the total
    reports products rather than "results".
  endcomment
  assign crk_is_search = false
  if template.name == 'search'
    assign crk_is_search = true
    assign crk_products = search.results
  endif

  comment
    Sets are a buying mechanism, not a product anyone should meet. They exist so
    "complete the set" can post one line to the cart with both garments on it,
    and they carry crooks.set_components to say so. Every loop below skips them,
    and the total is counted rather than taken from .size so the header cannot
    promise more pieces than the grid shows.

    They stay published to the Online Store on purpose: an unpublished product's
    variant cannot be added to the cart, so hiding them that way would break the
    toggle they exist for.
  endcomment
  assign crk_total = 0
  for item in crk_products
    if crk_is_search and item.object_type != 'product'
      continue
    endif
    if item.metafields.crooks.set_components
      continue
    endif
    assign crk_total = crk_total | plus: 1
  endfor

  comment
    On a collection page the collection's own title is the honest heading. The
    section setting still wins when it is filled in, so the homepage keeps
    "Catalogue" and a merchant can override any single page.
  endcomment
  assign crk_heading = section.settings.heading
  if crk_heading == blank and collection and collection.title != blank
    assign crk_heading = collection.title
  endif
  assign crk_show_count = true
  if crk_is_search
    if search.terms != blank
      assign crk_heading = section.settings.search_heading | replace: '[terms]', search.terms
    else
      assign crk_heading = section.settings.search_heading_blank
      assign crk_show_count = false
    endif
  endif

  comment
    Build the list of categories actually present, from product.type. Never a
    hardcoded list: a type that disappears from the catalogue must not leave a
    dead filter behind. Delimiters guard against substring collisions.
  endcomment
  assign crk_seen = '|'
  for product in crk_products
    if product.metafields.crooks.set_components
      continue
    endif
    assign crk_type = product.type | upcase
    if crk_type != blank
      assign crk_probe = '|' | append: crk_type | append: '|'
      unless crk_seen contains crk_probe
        assign crk_seen = crk_seen | append: crk_type | append: '|'
      endunless
    endif
  endfor

  comment
    Order them: preferred order first (only those present), then anything else.
  endcomment
  assign crk_ordered = ''
  assign crk_pref = section.settings.category_order | split: ','
  for pref in crk_pref
    assign pref_clean = pref | strip | upcase
    assign crk_probe = '|' | append: pref_clean | append: '|'
    if pref_clean != blank and crk_seen contains crk_probe
      assign crk_ordered = crk_ordered | append: pref_clean | append: '|'
    endif
  endfor
  assign crk_present = crk_seen | split: '|'
  for cat in crk_present
    assign crk_probe = '|' | append: cat | append: '|'
    assign crk_ordered_probe = '|' | append: crk_ordered
    if cat != blank
      unless crk_ordered contains crk_probe or crk_ordered_probe contains crk_probe
        assign crk_ordered = crk_ordered | append: cat | append: '|'
      endunless
    endif
  endfor
  assign crk_categories = crk_ordered | split: '|'
-%}

{%- comment -%}
  Nothing to render on a search page before a query is run: the grid is empty,
  the heading and count are suppressed, and what is left is an empty section —
  which the theme editor draws as a tall placeholder box. The query bar above
  already carries the prompt and the direct links, so this simply stands down.
{%- endcomment -%}
{%- if crk_is_search and search.terms == blank -%}
{%- else -%}
<section class="crk-root crk-section crk-exhibit-log" data-crk-section="exhibit-log" data-crk-view="product" id="{{ section.settings.anchor_id | default: 'exhibits' }}">
  <div class="crk-inner">
    <header class="crk-log__head">
      {%- comment -%}
        A collection page had no h1 at all — on this theme or the live one. The
        register is also the homepage's product grid, where the hero already
        owns the h1, so the level follows the template rather than being fixed.
      {%- endcomment -%}
      {%- if crk_heading != blank -%}
        {%- if template.name == 'collection' -%}
          <h1 class="crk-h2">{{ crk_heading }}</h1>
        {%- else -%}
          <h2 class="crk-h2">{{ crk_heading }}</h2>
        {%- endif -%}
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="crk-eyebrow">{{ section.settings.subheading }}</p>
      {%- endif -%}
      {%- if crk_show_count -%}
        {%- comment -%}
          The number is its own element so the filter can rewrite it without
          the label having to exist twice — once here and once in JS.
        {%- endcomment -%}
        {%- comment -%}
          "0 RESULTS" in the header tells nobody anything, and it shouted over
          the direct links above it — which are exactly where the answer to a
          word like "returns" lives, since Shopify cannot index a policy page or
          a page whose text sits in section settings. On an empty search the
          count is simply not drawn.
        {%- endcomment -%}
        {%- unless crk_is_search and crk_total == 0 -%}
          <span class="crk-log__count crk-micro" aria-live="polite"><span data-crk-count>{{ crk_total }}</span> {{ section.settings.count_label }}</span>
        {%- endunless -%}
      {%- endif -%}
    </header>

    {%- comment -%}
      Collection description (Promptd SEO/GEO audit 2026-10, findings C1-C5).
      It was only ever written into the structured data, never onto the page,
      so whatever is typed in Products > Collections > Description was
      invisible to shoppers and to crawlers counting the page's content. Shown
      under the heading on collection pages only; the homepage register and
      search results are unchanged. Nothing renders while a description is
      empty.
    {%- endcomment -%}
    {%- if template.name == 'collection' and collection.description != blank -%}
      <div class="crk-log__intro">{{ collection.description }}</div>
    {%- endif -%}

    {%- if section.settings.show_view_toggle -%}
      {%- comment -%}
        Product / Model view. Client-side over already-rendered cards, exactly
        like the category filters — no fetch, no reload.
      {%- endcomment -%}
      <div class="crk-views" role="group" aria-label="{{ section.settings.view_group_label | escape }}">
        <button type="button" class="crk-filter" data-crk-view-btn="product" aria-pressed="true">
          {{ section.settings.label_view_product }}
        </button>
        <button type="button" class="crk-filter" data-crk-view-btn="model" aria-pressed="false">
          {{ section.settings.label_view_model }}
        </button>
      </div>
    {%- endif -%}

    {%- comment -%}
      Temporary evaluation control for the alpha-trace outline on product shots.
      Applies at :root and persists for the session, so a choice made here also
      governs the product page. Dark mode only — light mode already sets
      filter: none, so the button does nothing there.

      Deliberately its own setting so it can be removed in one click once the
      question is settled, and its own data attribute so initLog's category
      filter never sees it (the two shared a class once already).
    {%- endcomment -%}
    {%- if section.settings.show_outline_toggle -%}
      <div class="crk-views" role="group" aria-label="{{ section.settings.outline_group_label | escape }}">
        <button
          type="button"
          class="crk-filter"
          data-crk-outline-btn
          data-crk-outline-default="{{ section.settings.outline_default }}"
          aria-pressed="true"
        >{{ section.settings.outline_label }}</button>
      </div>
    {%- endif -%}

    {%- comment -%}
      More than one category, not more than zero: on /collections/denim every product
      is Denim, so the rail would render "ALL | DENIM" — two controls that do nothing.
    {%- endcomment -%}
    {%- if section.settings.show_filters and crk_categories.size > 1 -%}
      <div class="crk-filters" role="group" aria-label="{{ section.settings.filters_label | escape }}">
        <button type="button" class="crk-filter" data-crk-filter="ALL" aria-pressed="true">
          {{ section.settings.all_label }}
        </button>
        {%- for cat in crk_categories -%}
          {%- if cat != blank -%}
            <button type="button" class="crk-filter" data-crk-filter="{{ cat | escape }}" aria-pressed="false">
              {{ cat }}
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%}
      Non-product results. The grid is product-shaped — image, price, colourways
      — so pages and articles get their own list rather than being dropped. This
      is what makes a search for "returns" or "delivery" land somewhere useful.
    {%- endcomment -%}
    {%- if crk_is_search -%}
      {%- assign crk_docs = 0 -%}
      {%- capture crk_doclist -%}
        {%- for item in crk_products -%}
          {%- if item.object_type == 'product' -%}{%- continue -%}{%- endif -%}
          {%- assign crk_docs = crk_docs | plus: 1 -%}
          <li>
            <a class="crk-links__item" href="{{ item.url }}">
              <span class="crk-links__label">{{ item.title }}</span>
              <span class="crk-links__note">{{ item.object_type | upcase }}</span>
            </a>
          </li>
        {%- endfor -%}
      {%- endcapture -%}
      {%- if crk_docs > 0 -%}
        <div class="crk-links crk-links--results">
          {%- if section.settings.docs_heading != blank -%}
            <p class="crk-eyebrow">{{ section.settings.docs_heading }}</p>
          {%- endif -%}
          <ul class="crk-links__list">{{ crk_doclist }}</ul>
        </div>
      {%- endif -%}
    {%- endif -%}

    {%- comment -%}
      Evidence windows are an experiment in how the flat-lay shots are presented.
      Everything it changes hangs off this one modifier class, so unticking the
      setting returns the grid to exactly what it was without a code change.
    {%- endcomment -%}
    <ul class="crk-log__grid{% if section.settings.evidence_windows %} crk-log__grid--evidence-windows{% endif %}">
      {%- for product in crk_products -%}
        {%- liquid
          comment
            search.results mixes products with articles and pages; only products
            have the fields a card renders.
          endcomment
          if crk_is_search and product.object_type != 'product'
            continue
          endif
          if product.metafields.crooks.set_components
            continue
          endif

          assign crk_cat = product.type | upcase
          assign crk_main = product.featured_image
          assign crk_alt = product.images[1]

          comment
            Filing date. The status slot rendered a constant on all fourteen cards, so
            the register could not tell a returning shopper what had changed. A date is
            more in voice than "NEW" and it is a fact rather than a claim — it reports
            when the product went on the storefront, nothing more.

            The window is a setting because it is the merchant's editorial call: too wide
            and every card is stamped, which is the same as no signal at all.
          endcomment
          comment
            Colourway swatches. Generic: the option treated as "colour" comes from a
            setting, because this catalogue already spells it two ways — three tees use
            "Colour" and CRXST*RZ uses "Color" — and a future product may use neither.

            Colour source, in order: the merchant's configured Shopify swatch, else the
            option value used directly as a CSS colour keyword (BLACK, WHITE, NAVY... all
            resolve). Nothing is hardcoded and no colour is invented: if neither resolves
            the square renders empty-with-a-rule and the hidden text still names it.

            Only rendered when the option has more than one value — "available in one
            colour" is not information.
          endcomment
          assign crk_sw = null
          assign crk_sw_pos = 0
          if section.settings.show_colourways
            assign crk_names = section.settings.colour_option_names | downcase
            for opt in product.options_with_values
              assign crk_nm = opt.name | downcase | strip
              assign crk_probe = ',' | append: crk_nm | append: ','
              assign crk_hay = ',' | append: crk_names | append: ','
              assign crk_hay = crk_hay | replace: ', ', ','
              if crk_hay contains crk_probe and opt.values.size > 1
                assign crk_sw = opt
                assign crk_sw_pos = forloop.index
                break
              endif
            endfor
          endif

          comment
            One pass over the variants to learn which colourways are actually buyable.
            A swatch for a colourway that is entirely gone would be a lie on a card the
            shopper has not opened yet.
          endcomment
          assign crk_sw_live = '|'
          if crk_sw
            for v in product.variants
              if v.available
                case crk_sw_pos
                  when 1
                    assign crk_vv = v.option1
                  when 2
                    assign crk_vv = v.option2
                  else
                    assign crk_vv = v.option3
                endcase
                assign crk_probe = '|' | append: crk_vv | append: '|'
                unless crk_sw_live contains crk_probe
                  assign crk_sw_live = crk_sw_live | append: crk_vv | append: '|'
                endunless
              endif
            endfor
          endif

comment
            Per-size availability now lives in crooks-sizes-left so the product
            page's related rail can use the identical rule. The rail was blind
            to half-sold pieces precisely because this was section-local.
          endcomment

          assign crk_filed = false
          if product.published_at and section.settings.filed_days > 0
            assign crk_now_s = 'now' | date: '%s' | times: 1
            assign crk_pub_s = product.published_at | date: '%s' | times: 1
            assign crk_age = crk_now_s | minus: crk_pub_s | divided_by: 86400
            if crk_age >= 0 and crk_age <= section.settings.filed_days
              assign crk_filed = true
              comment
                Format the date into its own variable first. Inlining it as
                `filed_label | replace: '[date]', product.published_at | date: fmt`
                parses as replace(...) THEN date(...), so `date` reformats the whole
                replaced string and swallows the label — it rendered "13.07", not
                "FILED 13.07".
              endcomment
              assign crk_filed_on = product.published_at | date: section.settings.filed_format
            endif
          endif
          comment
            Outline everything EXCEPT JPEG. JPEG cannot carry an alpha channel,
            so a JPEG product shot always has a baked-in background and the
            filter would trace the rectangle rather than the garment. PNG and
            WebP both support alpha and this catalogue uses both — testing for
            .png alone wrongly excluded six cut-out WebP files. Verified against
            the source audit in NOTES.md: every baked-white image is a JPEG and
            every non-JPEG is a clean cut-out.
          endcomment
          assign main_src = crk_main.src | downcase
          assign alt_src = crk_alt.src | downcase
          assign main_cls = 'crk-card__img crk-card__img--main'
          unless main_src contains '.jpg' or main_src contains '.jpeg'
            assign main_cls = main_cls | append: ' crk-product-image'
          endunless
          assign alt_cls = 'crk-card__img crk-card__img--alt'
          unless alt_src contains '.jpg' or alt_src contains '.jpeg'
            assign alt_cls = alt_cls | append: ' crk-product-image'
          endunless
          comment
            Model view. A real per-product shot wins; otherwise the section's
            placeholder stands in, so the treatment can be judged across the
            whole grid before every product has been shot.
          endcomment
          assign crk_model = product.metafields.crooks.model_image.value
          assign crk_model_is_real = true
          unless crk_model
            assign crk_model = section.settings.model_placeholder
            assign crk_model_is_real = false
          endunless
          assign model_src = crk_model.src | downcase
          assign model_cls = 'crk-card__img crk-card__img--model'
          unless model_src contains '.jpg' or model_src contains '.jpeg'
            assign model_cls = model_cls | append: ' crk-product-image'
          endunless
        -%}
        {%- liquid
          comment
            QUICK ADD data. The size option is whichever option is actually
            named like a size — this catalogue spells colour two ways already,
            so nothing is assumed about position or spelling. Values render in
            Shopify's own order, which is the merchant's order and is already
            XS-S-M-L-XL; re-sorting here would break the first product that
            sells a size this theme has never heard of.
          endcomment
          assign crk_qa_opt = null
          assign crk_qa_pos = 0
          for opt in product.options_with_values
            assign crk_nm2 = opt.name | downcase
            if crk_nm2 contains 'size'
              assign crk_qa_opt = opt
              assign crk_qa_pos = forloop.index
              break
            endif
          endfor

          comment
            A product with one option resolves a size straight to a variant. One
            with two — size AND colour — does not: picking M on a tee sold in
            black and white names two variants, and guessing which the shopper
            meant is how a quick add posts the wrong garment. Those cards send
            the shopper to the product page instead, with the size already
            chosen. The button says so rather than pretending.
          endcomment
          assign crk_qa_axes = product.options_with_values.size

          comment
            The whole-product fallback for a piece with no size at all: socks
            are sold by Quantity, a balaclava is one size. Those quick add the
            first buyable variant, because there is no second decision to make.
          endcomment
          assign crk_qa_solo = null
          unless crk_qa_opt
            for v in product.variants
              if v.available
                assign crk_qa_solo = v
                break
              endif
            endfor
          endunless
        -%}
        <li class="crk-log__cell" data-crk-category="{{ crk_cat | escape }}"{% if crk_model %} data-crk-has-model="{% if crk_model_is_real %}real{% else %}placeholder{% endif %}"{% endif %}>
          <div
            class="crk-card{% if crk_alt %} crk-card--swap{% endif %}{% unless product.available %} crk-card--sold{% endunless %}"
            data-crk-qa
            data-crk-qa-url="{{ product.url }}"
            data-crk-qa-title="{{ product.title | escape }}"
          >
            {%- comment -%}
              The image links to the product, but it is the same destination as
              the name directly beneath it. Two links to one place is noise on a
              screen reader and an extra tab stop for a keyboard, so this one is
              taken out of the tree and the name carries the accessible link.
            {%- endcomment -%}
            <a class="crk-card__medialink" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
              <span class="crk-card__media">
                {%- if crk_main -%}
                  {%- comment -%}
                    The first row of a collection is what a phone shows on
                    arrival, and its first image is the page's largest paint
                    (measured on /collections/denim and /collections/all). Those
                    two load straight away, the first at high priority; every
                    other card stays lazy (audit I3, I4).
                  {%- endcomment -%}
                  {%- liquid
                    assign crk_load = 'lazy'
                    assign crk_prio = 'auto'
                    if template.name == 'collection' and forloop.index <= 2
                      assign crk_load = 'eager'
                      if forloop.first
                        assign crk_prio = 'high'
                      endif
                    endif
                  -%}
                  {{
                    crk_main
                    | image_url: width: 800
                    | image_tag:
                      loading: crk_load,
                      fetchpriority: crk_prio,
                      widths: '200, 300, 400, 600, 800',
                      sizes: '(min-width: 1024px) 25vw, 50vw',
                      class: main_cls,
                      alt: crk_main.alt
                  }}
                {%- endif -%}
                {%- if crk_alt -%}
                  {{
                    crk_alt
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      widths: '200, 300, 400, 600, 800',
                      sizes: '(min-width: 1024px) 25vw, 50vw',
                      class: alt_cls,
                      alt: ''
                  }}
                {%- endif -%}
                {%- if crk_model -%}
                  {{
                    crk_model
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      widths: '200, 300, 400, 600, 800',
                      sizes: '(min-width: 1024px) 25vw, 50vw',
                      class: model_cls,
                      alt: ''
                  }}
                {%- endif -%}
              </span>
            </a>

            <a class="crk-card__namelink" href="{{ product.url }}">
              <span class="crk-card__name">{% render 'crooks-title', product: product %}</span>
            </a>

            {%- if crk_sw -%}
              {%- capture crk_sw_names -%}
                {%- for val in crk_sw.values -%}
                  {%- assign nm = val.name | default: val -%}
                  {{ nm }}{% unless forloop.last %}, {% endunless %}
                {%- endfor -%}
              {%- endcapture -%}
              <span class="crk-card__sw" aria-hidden="true">
                {%- for val in crk_sw.values -%}
                  {%- liquid
                    assign nm = val.name | default: val
                    assign col = val.swatch.color
                    if col == blank
                      assign col = nm | downcase | replace: ' ', ''
                    endif
                    assign probe = '|' | append: nm | append: '|'
                    assign live = true
                    unless crk_sw_live contains probe
                      assign live = false
                    endunless
                  -%}
                  <span class="crk-card__swatch" style="--crk-sw: {{ col }}"{% unless live %} data-crk-sw-out="true"{% endunless %}></span>
                {%- endfor -%}
              </span>
              <span class="crk-sr">{{ section.settings.colourways_sr_label }}: {{ crk_sw_names | strip }}</span>
            {%- endif -%}

            <p class="crk-card__price">
              {%- liquid
                comment
                  Formatted into variables first: chaining money inside the output
                  tag is the precedence trap this codebase has hit repeatedly.
                endcomment
                assign crk_now_money = product.price | money
                assign crk_was_money = product.compare_at_price | money
              -%}
              <span class="crk-price">{{ crk_now_money }}</span>
              {%- if product.compare_at_price > product.price -%}
                <s class="crk-card__was">{{ crk_was_money }}</s>
              {%- endif -%}
            </p>

            {%- if crk_filed and product.available and section.settings.filed_label != blank -%}
              <span class="crk-card__dropped">{{ section.settings.filed_label | replace: '[date]', crk_filed_on }}</span>
            {%- endif -%}

            {%- if crk_qa_opt -%}
              <div
                class="crk-card__sizes"
                role="group"
                aria-label="{{ section.settings.qa_sizes_label | replace: '[product]', product.title | escape }}"
              >
                {%- for val in crk_qa_opt.values -%}
                  {%- liquid
                    assign crk_v_name = val.name | default: val

                    comment
                      How many buyable variants wear this size, and which is the
                      first. One means the size names a variant outright. More
                      than one means a second choice is still open.
                    endcomment
                    assign crk_v_count = 0
                    assign crk_v_id = ''
                    for v in product.variants
                      unless v.available
                        continue
                      endunless
                      case crk_qa_pos
                        when 1
                          assign crk_vv2 = v.option1
                        when 2
                          assign crk_vv2 = v.option2
                        else
                          assign crk_vv2 = v.option3
                      endcase
                      if crk_vv2 == crk_v_name
                        assign crk_v_count = crk_v_count | plus: 1
                        if crk_v_id == ''
                          assign crk_v_id = v.id
                        endif
                      endif
                    endfor
                  -%}
                  <button
                    type="button"
                    class="crk-card__size"
                    data-crk-qa-size="{{ crk_v_name | escape }}"
                    {%- if crk_v_count == 1 %} data-crk-qa-variant="{{ crk_v_id }}"{% endif -%}
                    {%- if crk_v_count > 1 %} data-crk-qa-choose="true"{% endif -%}
                    {%- if crk_v_count == 0 %} aria-disabled="true"{% endif -%}
                    aria-pressed="false"
                  >{{ crk_v_name }}{%- if crk_v_count == 0 -%}<span class="crk-sr"> {{ section.settings.qa_sold_sr }}</span>{%- endif -%}</button>
                {%- endfor -%}
              </div>
            {%- endif -%}

            {%- comment -%}
              The button starts as a real disabled control rather than an armed
              one that fails on click. crooks-quickadd.js relabels it the moment
              a size is chosen. Without that file it stays disabled and the card
              is still a working link to the product page.
            {%- endcomment -%}
            {%- liquid
              assign crk_qa_state = 'need-size'
              assign crk_qa_text = section.settings.qa_select_label
              unless product.available
                assign crk_qa_state = 'sold'
                assign crk_qa_text = section.settings.qa_sold_label
              endunless
              if product.available and crk_qa_opt == null
                assign crk_qa_state = 'ready'
                assign crk_qa_text = section.settings.qa_add_label
              endif
            -%}
            <button
              type="button"
              class="crk-card__qa"
              data-crk-qa-btn
              data-crk-qa-state="{{ crk_qa_state }}"
              {%- if crk_qa_solo %} data-crk-qa-variant="{{ crk_qa_solo.id }}"{% endif -%}
              {%- if crk_qa_axes > 1 %} data-crk-qa-multi="true"{% endif -%}
              data-crk-qa-add="{{ section.settings.qa_add_label | escape }}"
              data-crk-qa-select="{{ section.settings.qa_select_label | escape }}"
              data-crk-qa-choose="{{ section.settings.qa_choose_label | escape }}"
              data-crk-qa-busy="{{ section.settings.qa_busy_label | escape }}"
              data-crk-qa-done="{{ section.settings.qa_done_label | escape }}"
              data-crk-qa-error="{{ section.settings.qa_error_label | escape }}"
              {%- unless product.available %} disabled{% endunless -%}
            >{{ crk_qa_text }}</button>

            <p class="crk-card__qamsg" data-crk-qa-msg role="status" aria-live="polite" hidden></p>
          </div>
        </li>
      {%- endfor -%}
    </ul>

    {%- comment -%}
      Shown by JS when a filter matches nothing. Visible without JS only when the
      collection itself is empty, which is the honest state in that case.
    {%- endcomment -%}
    {%- liquid
      comment
        A search page with no query has not failed to match anything — nothing
        has been asked yet. Saying "no records match" there reads as a broken
        search, which is exactly how it was reported.
      endcomment
      assign crk_empty = section.settings.empty_text
      if crk_is_search and search.terms == blank
        assign crk_empty = section.settings.empty_text_noquery
      endif
    -%}
    {%- if crk_empty != blank -%}
      <p class="crk-log__empty"{% if crk_total > 0 %} hidden{% endif %}>{{ crk_empty }}</p>
    {%- endif -%}
  </div>
</section>

{%- comment -%}
  Collection structured data. ItemList names the products this page actually
  renders, in the order it renders them, so it can never describe a grid that
  is not there. Only on a real collection page — not the homepage register, and
  not search results, which should not be indexed at all.
{%- endcomment -%}
{%- if template.name == 'collection' and collection and collection.handle != blank -%}
  {%- assign crk_col_url = shop.url | append: collection.url -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "@id": {{ crk_col_url | append: '#collection' | json }},
    "name": {{ collection.title | json }},
    "url": {{ crk_col_url | json }},
    {% if collection.description != blank %}"description": {{ collection.description | strip_html | strip_newlines | truncate: 320 | json }},{% endif %}
    "isPartOf": { "@id": {{ shop.url | append: '#website' | json }} },
    "mainEntity": {
      "@type": "ItemList",
      "numberOfItems": {{ crk_total | json }},
      "itemListElement": [
        {%- assign crk_pos = 0 -%}
        {%- for product in crk_products limit: 30 -%}
          {%- if product.metafields.crooks.set_components -%}{%- continue -%}{%- endif -%}
          {%- assign crk_pos = crk_pos | plus: 1 -%}
          {%- if crk_pos > 1 -%},{%- endif -%}
          {
            "@type": "ListItem",
            "position": {{ crk_pos }},
            "name": {{ product.title | json }},
            "url": {{ shop.url | append: product.url | json }}
          }
        {%- endfor -%}
      ]
    }
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.url | json }} },
      { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ crk_col_url | json }} }
    ]
  }
  </script>
{%- endif -%}

{%- endif -%}

{% schema %}
{
  "name": "Crooks — Catalogue",
  "tag": "section",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "CATALOGUE" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "count_label", "label": "Count label", "default": "ITEMS" },
    { "type": "text", "id": "search_heading", "label": "Search heading", "info": "Use [terms].", "default": "Search: [terms]" },
    { "type": "text", "id": "search_heading_blank", "label": "Search heading (no terms)", "default": "Search" },
    { "type": "text", "id": "exhibit_prefix", "label": "Product number prefix", "default": "NO." },
    { "type": "header", "content": "View mode" },
    { "type": "checkbox", "id": "show_view_toggle", "label": "Show Product / Model view toggle", "default": true },
    { "type": "text", "id": "label_view_product", "label": "Product view label", "default": "Flat" },
    { "type": "text", "id": "label_view_model", "label": "Model view label", "default": "On model" },
    { "type": "text", "id": "view_group_label", "label": "View toggle label (screen readers)", "default": "Choose how products are shown" },
    { "type": "image_picker", "id": "model_placeholder", "label": "Model view placeholder", "info": "Stands in for any product with no Model image metafield set. Leave empty to show the product image instead." },
    { "type": "header", "content": "Filters" },
    { "type": "checkbox", "id": "show_filters", "label": "Show category filters", "default": true },
    { "type": "text", "id": "all_label", "label": "\"All\" filter label", "default": "ALL" },
    {
      "type": "text",
      "id": "category_order",
      "label": "Preferred category order",
      "info": "Comma-separated. Categories come from each product's type. Any present category not listed here is appended at the end; any listed category with no products is skipped.",
      "default": "T-SHIRT, DENIM, SWEATS, ACCESSORIES"
    },
    { "type": "text", "id": "filters_label", "label": "Filter group label (screen readers)", "default": "Filter products" },
    { "type": "header", "content": "Status labels" },
    { "type": "checkbox", "id": "show_outline_toggle", "label": "Show the white-outline toggle", "info": "Temporary control for comparing product shots with and without the outline. Dark mode only.", "default": true },
    { "type": "text", "id": "outline_label", "label": "Outline toggle label", "default": "Outline" },
    { "type": "text", "id": "outline_group_label", "label": "Outline toggle group label (screen readers)", "default": "Product image outline" },
    { "type": "select", "id": "outline_default", "label": "Outline default", "options": [{ "value": "on", "label": "On" }, { "value": "off", "label": "Off" }], "default": "on" },
    { "type": "checkbox", "id": "show_colourways", "label": "Show colourway swatches on cards", "default": true },
    { "type": "text", "id": "colour_option_names", "label": "Option names treated as colourways", "info": "Comma separated. Matched case-insensitively.", "default": "Colour,Color,Colourway,Colorway" },
    { "type": "text", "id": "colourways_sr_label", "label": "Colourways label (screen readers)", "default": "Colourways" },
    { "type": "text", "id": "available_label", "label": "Available label", "default": "AVAILABLE" },

    { "type": "header", "content": "Quick add" },
    { "type": "paragraph", "content": "Every label is a setting. Sizes come from the product's own size option and render in Shopify's order, so nothing here needs touching when a product is added." },
    { "type": "text", "id": "qa_sizes_label", "label": "Size group label (screen readers)", "info": "[product] is replaced with the product name, so each card's size buttons say which garment they belong to.", "default": "Size, [product]" },
    { "type": "text", "id": "qa_select_label", "label": "Before a size is chosen", "default": "SELECT SIZE" },
    { "type": "text", "id": "qa_add_label", "label": "Ready to add", "default": "QUICK ADD" },
    { "type": "text", "id": "qa_choose_label", "label": "When a second choice is open", "info": "Shown on products sold in more than one colourway, where a size alone does not name a variant. The button opens the product page instead of guessing.", "default": "CHOOSE COLOUR" },
    { "type": "text", "id": "qa_busy_label", "label": "While adding", "default": "ADDING\u2026" },
    { "type": "text", "id": "qa_done_label", "label": "Added", "default": "ADDED TO BAG" },
    { "type": "text", "id": "qa_error_label", "label": "If the add fails", "default": "COULD NOT ADD" },
    { "type": "text", "id": "qa_sold_label", "label": "Sold out", "default": "SOLD OUT" },
    { "type": "text", "id": "qa_sold_sr", "label": "Sold-out size, screen readers", "info": "Read after the size name, so a strike-through is not the only way to know.", "default": "sold out" },
    { "type": "text", "id": "low_stock_label", "label": "Low stock label", "default": "LOW STOCK" },
    { "type": "text", "id": "sizes_left_label", "label": "Some sizes gone label", "info": "Shown when a piece is still buyable but not in every size. [n] is how many sizes are left, [m] how many there are. Leave blank to show the available label instead.", "default": "[n] OF [m] SIZES LEFT" },
    { "type": "range", "id": "low_stock_threshold", "label": "Low stock at or below", "unit": "u", "min": 0, "max": 20, "step": 1, "default": 3 },
    { "type": "text", "id": "filed_label", "label": "Drop date label", "info": "Use [date]. Shown BELOW the stock status, never instead of it. Leave empty to hide the date.", "default": "DROPPED [date]" },
    { "type": "text", "id": "filed_format", "label": "Filing date format", "info": "Liquid date format. %d.%m gives 08.08.", "default": "%d.%m" },
    { "type": "range", "id": "filed_days", "label": "Treat as recently filed for", "unit": "d", "min": 0, "max": 90, "step": 1, "default": 30 },
    { "type": "text", "id": "sold_out_label", "label": "Sold out label", "default": "SOLD OUT" },
    { "type": "text", "id": "empty_text", "label": "Empty state text", "default": "Nothing in this category yet." },
    { "type": "text", "id": "empty_text_noquery", "label": "Empty state text (search, no query yet)", "default": "ENTER A QUERY ABOVE TO SEARCH THE REGISTER." },
    { "type": "text", "id": "docs_heading", "label": "Search: heading for page results", "default": "PAGES & ANSWERS" },
    { "type": "header", "content": "Evidence windows (experiment)" },
    { "type": "checkbox", "id": "evidence_windows", "label": "Enable evidence window image styling", "info": "Presentation only: a lit stage behind each garment, larger flat-lays and a softer outline. Untick to return the grid to its previous appearance.", "default": true },
    { "type": "header", "content": "Advanced" },
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "info": "Used by in-page links such as the hero's primary button.", "default": "exhibits" }
  ],
  "presets": [{ "name": "Crooks — Catalogue" }]
}
{% endschema %}

{% stylesheet %}
  /* Collection description under the heading (crooks-exhibit-log). Reads like
     the Terms and FAQ standfirst: one quiet paragraph, never a block. */
  .crk-log__intro { margin: -8px 0 24px; max-width: 64ch; color: var(--crk-paper); font-size: 13px; line-height: 1.6 }
  .crk-log__intro p { margin: 0 0 8px }
  .crk-log__intro p:last-child { margin-bottom: 0 }
{% endstylesheet %}

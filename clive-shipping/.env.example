# CLIVE Shipping service. Copy to .env beside this file, on the server only; every value is
# SHIPPING_<NAME>. Live secrets never go in the repo or in chat.

# --- Shopify: the same app as Returns (CROOKS Operations), so the same three values ---
SHIPPING_SHOP_DOMAIN=5wn03t-nm.myshopify.com
SHIPPING_SHOPIFY_CLIENT_ID=
SHIPPING_SHOPIFY_CLIENT_SECRET=
SHIPPING_SHOPIFY_BACKEND=graphql

# --- Parcel2Go: Shipping's own API credential (not the Returns one) ---
SHIPPING_PROVIDER=parcel2go
# Live: https://www.parcel2go.com   Sandbox: https://sandbox.parcel2go.com
SHIPPING_P2G_BASE_URL=https://www.parcel2go.com
SHIPPING_P2G_CLIENT_ID=
SHIPPING_P2G_CLIENT_SECRET=

# --- Easyship (second provider; public API 2024-09) ---
# A production token starts "prod_", sandbox "sand_"; the token decides which Easyship is used.
# Empty: Easyship isn't asked. Enter it on the server only (see docs/deploy/CROOKS_OPERATIONS.md).
SHIPPING_EASYSHIP_ACCESS_TOKEN=

# --- Money safety ---
# true authorises any otherwise-valid order; all existing purchase safeguards still apply.
# false uses the explicit per-order allowlist below (empty = no buying).
SHIPPING_BUYING_ENABLED=false
# Restrictive fallback/emergency mode: comma-separated order numbers, e.g. 2190,2191.
SHIPPING_AUTHORISED_ORDERS=

# --- the service ---
# Reconcile purchases, retry Shopify, refresh orders (re-quoting each ready order): seconds
# between sweeps. 300 keeps Parcel2Go quote calls modest; payment checks wait at most this long.
SHIPPING_TICK_INTERVAL_S=300

# Physical label printing; disabled until reviewed deployment. Set the key on the server only.
PRINTNODE_ENABLED=false
PRINTNODE_PRINTER_ID=75883753
PRINTNODE_API_KEY=

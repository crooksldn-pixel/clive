# CLIVE Shipping service. Copy to .env beside this file, on the server only; every value is
# SHIPPING_<NAME>. Live secrets never go in the repo or in chat.

# --- Shopify: the same app as Returns (CROOKS Operations), so the same three values ---
SHIPPING_SHOP_DOMAIN=5wn03t-nm.myshopify.com
SHIPPING_SHOPIFY_CLIENT_ID=
SHIPPING_SHOPIFY_CLIENT_SECRET=
SHIPPING_SHOPIFY_BACKEND=graphql

# --- Parcel2Go: Shipping's own API credential (not the Returns one) ---
SHIPPING_PROVIDER=parcel2go
# Live: https://www.parcel2go.com   Sandbox: https://sandbox.parcel2go.com
SHIPPING_P2G_BASE_URL=https://www.parcel2go.com
SHIPPING_P2G_CLIENT_ID=
SHIPPING_P2G_CLIENT_SECRET=

# --- Easyship (second provider; public API 2024-09) ---
# A production token starts "prod_", sandbox "sand_"; the token decides which Easyship is used.
# Empty: Easyship isn't asked. Enter it on the server only (see docs/deploy/CROOKS_OPERATIONS.md).
SHIPPING_EASYSHIP_ACCESS_TOKEN=

# --- Money safety ---
# true authorises any otherwise-valid order; all existing purchase safeguards still apply.
# false uses the explicit per-order allowlist below (empty = no buying).
SHIPPING_BUYING_ENABLED=false
# Restrictive fallback/emergency mode: comma-separated order numbers, e.g. 2190,2191.
SHIPPING_AUTHORISED_ORDERS=

# --- UK labels (Shopify Shipping) ---
# off: UK orders stay in Shopify's own flow and aren't shown here. shopify: UK orders appear
# here and their labels are bought from this store's Shopify Shipping account, charged to the
# Shopify bill. Shopify shows no price before buying. Needs the write_orders scope on the
# Shopify app (docs/V1_RELEASE.md). The buying authorisation above still applies.
SHIPPING_DOMESTIC_LABELS=off
# Which Royal Mail service each checkout delivery method gets, by its exact title (case and
# spacing don't matter). A title not listed waits in Needs attention for a person to choose.
# The store's titles, read from its orders on 2026-10-09: "Tracked 24", "Tracked 48".
SHIPPING_DOMESTIC_SHIPPING_LINES="Tracked 24=24; Tracked 48=48"
# Shopify Shipping's own carrier and service code for each service: "<carrierCode>/<serviceCode>".
# Shopify publishes no list of them and has no API to look them up; get them from Shopify.
# Empty: that service can't be bought here (CLIVE never lets Shopify choose the rate).
SHIPPING_SHOPIFY_TRACKED_24_RATE=
SHIPPING_SHOPIFY_TRACKED_48_RATE=

# --- the service ---
# Reconcile purchases, retry Shopify, refresh orders (re-quoting each ready order): seconds
# between sweeps. 300 keeps Parcel2Go quote calls modest; payment checks wait at most this long.
SHIPPING_TICK_INTERVAL_S=300

# Physical label printing; disabled until reviewed deployment. Set the key on the server only.
PRINTNODE_ENABLED=false
PRINTNODE_PRINTER_ID=75883753
PRINTNODE_API_KEY=

# --- CLIVE (/api/v1) ---
# Bearer keys CLIVE uses, comma-separated; a write key can also read. Generate on the server
# (e.g. python3 -c "import secrets;print(secrets.token_urlsafe(32))"), never in chat or the repo.
# Empty: the API answers nothing. Buying through it still needs the buying authorisation above.
SHIPPING_CLIVE_READ_KEYS=
SHIPPING_CLIVE_WRITE_KEYS=

# --- Commodity codes ---
# "Find the code" reads the official UK Trade Tariff (read only, no key). The server needs
# outbound HTTPS to www.trade-tariff.service.gov.uk. Off: codes are typed by hand, unchecked.
SHIPPING_TARIFF_ENABLED=true
SHIPPING_TARIFF_BASE_URL=https://www.trade-tariff.service.gov.uk/uk/api
